// ═══════════════════════════════════════════════════════════════════════════
// doubuleA — 数据模型第一批（P0-1-5）
//
// 依据：`docs/02-后端设计.md` §三（数据模型核心表）。
// 落地进度：第一批 7 张表见 P0-1-5；知识库三表（knowledge_bases/documents/chunks）
// 见 P0-1-14（本文件末尾，含"为什么两个索引不在这里声明"的说明）；
// mcp/sandbox/artifact 等表在 P0-2/P0-3 批次落。
//
// 命名约定：Prisma 侧 camelCase，数据库侧 snake_case（`@map` / `@@map` 逐列映射），
// 与 `02` §三 的列名逐字对齐 —— 手写 SQL 迁移与 `psql` 排查时不用做心算转换。
//
// ⚠️ messages 是**按月分区表**（`02` §三 分区说明），Prisma 没有分区语法，
//    因此 `prisma/migrations/0001_init/migration.sql` 由 `prisma migrate diff --script`
//    生成基础 DDL 后**手工改造**（复合主键 + PARTITION BY RANGE + 分区维护函数）。
//    实测（P0-1-5）：改造后 Prisma 的内省能正确识别分区关系，`migrate dev` 不会
//    尝试重建它 —— 以后要给 Message 加列，照常改这个模型、照常 `migrate dev` 就行。
//    细节与反向探针记录见 `issue_fix/问题记录-P0-1-5-数据模型与Prisma基线.md`。
// ═══════════════════════════════════════════════════════════════════════════

// ───────────────────────────── 生成器 / 数据源 ─────────────────────────────

/// Prisma 7 的 Rust-free 客户端（`prisma-client`，旧的 `prisma-client-js` 将被移除）。
/// 三个关键点（与仓库工程约定绑定，改动前先读 docs/06 §3.0 与 tsconfig.base.json）：
///   · `output` 在 v7 是**必填**（不再往 node_modules 里生成），产物落 backend/generated/prisma
///     （已 gitignore：它是生成物，由 `prisma generate` / `postinstall` 重建）。
///   · `moduleFormat = "esm"` + `importFileExtension = "js"`：本仓库是 `"type": "module"`
///     + tsc 编译（不是打包器），生成码内部的相对导入必须带 `.js` 后缀，否则运行期
///     `ERR_MODULE_NOT_FOUND`（与 src 里「相对导入一律写 .js」是同一条约定）。
///   · `generatedFileExtension = "ts"`：生成 TS 源码，由本包 tsc 一并编译进 dist。
generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

/// 连接串不写在这里：Prisma 7 起改由 `prisma.config.ts` 提供（v7 迁移指南明确
/// datasource 的 `url`/`directUrl`/`shadowDatabaseUrl` 字段已废弃）。
/// 这样「迁移用哪个库」与「应用配置」解耦 —— `prisma migrate` 只需要 DATABASE_URL，
/// 不需要 S3 / embedding / 主密钥等一堆应用侧变量（详见 prisma.config.ts 头注释）。
datasource db {
  provider = "postgresql"
}

// ───────────────────────────── 枚举（`02` §三 括号内的取值域）─────────────────────────────

/// 用户角色（`01` §3.1：admin 建号；无自注册）
enum UserRole {
  ADMIN
  MEMBER

  @@map("user_role")
}

/// 用户状态：启停（`01` §3.1「被停用账号立即失效」）。
/// 刻意用 DISABLED 而非 DELETED —— 本系统不删用户（历史会话/用量要留痕）。
enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

/// provider 与 model 共用的类型域（`02` §三 两处都写 `type(CHAT|EMBEDDING)`）。
/// 共用一个枚举而不是各建一个：两者本就同一取值域，将来加第三类（如 RERANK）只改一处。
enum ModelType {
  CHAT
  EMBEDDING

  @@map("model_type")
}

/// **上游协议**（P0-1-37）：Provider 的上游"怎么说话"。
///
/// ⚠️ 与 `ModelType`（用途）是两件事：同一个"对话"用途可以走三种报文形状。
/// · `OPENAI_COMPAT`   —— `POST {baseUrl}/chat/completions` + `Authorization: Bearer`（**默认**，P0-1-37 之前的全部行为）
/// · `OPENAI_RESPONSES`—— `POST {baseUrl}/responses`
/// · `ANTHROPIC_MESSAGES` —— `POST {baseUrl}/messages` + `x-api-key` + `anthropic-version`
///
/// 默认值 `OPENAI_COMPAT` 让既有行**逐字保持原行为**（`02` §6.1 的三协议映射表）。
/// `type = EMBEDDING` 只允许 `OPENAI_COMPAT`（embedding 只有 `/embeddings` 一条路，
/// 判据收在 `shared/src/modelProvider.ts#protocolAllowedForType`）。
enum UpstreamProtocol {
  OPENAI_COMPAT
  OPENAI_RESPONSES
  ANTHROPIC_MESSAGES

  @@map("upstream_protocol")
}

/// Agent 类型（`01` 决策 4：ChatBot 主 + TaskAgent 辅）
enum AgentType {
  CHATBOT
  TASK_AGENT

  @@map("agent_type")
}

/// Agent 可绑定的组件类型（`01` 决策 7：仅知识库 + MCP 两种）
enum ComponentType {
  KNOWLEDGE
  MCP

  @@map("component_type")
}

/// 会话状态（`02` §三）。FINISHED 之后的会话转只读保留（`02` §4.4 删除 Agent 时）
enum ConversationStatus {
  ACTIVE
  FINISHED

  @@map("conversation_status")
}

/// 消息角色（`02` §三）
enum MessageRole {
  USER
  ASSISTANT
  SYSTEM

  @@map("message_role")
}

/// 文档在流水线中的状态（`02` §三 / `子方案①` §三）
///
/// · `PARSING` 是**初始态**（`子方案①` §三 第 ① 步：登记即入队），worker 成功后转 `READY`、
///   任一步抛错转 `FAILED`（`error_msg` 落可读原因，`POST .../retry` 重新入队）。
/// · 不设 `DELETED`：删除是**物理删除**行（连带级联清 chunks，`02` §4.6）。
enum DocumentStatus {
  PARSING
  READY
  FAILED

  @@map("document_status")
}

/// MCP server 的注册方式（`02` §三：`auth_type(NONE|OAUTH)`）。
/// ⚠️ **P0 只接受 `NONE`**：`OAUTH` 的列先建出来（免得 P1 改表），但注册时收到它就 400 ——
/// 与 P0-1-23 拒绝 `MCP` 绑定同一条定案（`06` §4.0 口径 1："接口留位、能力不做"，
/// 不要"先收下、等以后有实现再收拾"）。OAuth 2.1 属 **P1**（`04` 评审 A7 建议 (a)）。
enum McpAuthType {
  NONE
  OAUTH

  @@map("mcp_auth_type")
}

/// MCP server 的**连通健康态**（`02` §三 原文只写了列名 `status`，取值域由 P0-2-2 补定）。
/// `UNKNOWN` = 从未测过（刚注册且探测失败）；`OK` / `ERROR` = 最近一次 `POST /:id/test` 的结论。
/// ⚠️ 它**不是启停开关** —— P0 不提供"停用"入口（"停用后工具不可见"属 P0-2-5/P0-2-6，
/// 现在加一个只有写入、没有读取方的状态位只会造出"看着能停、其实照跑"的假开关）。
enum McpServerStatus {
  UNKNOWN
  OK
  ERROR

  @@map("mcp_server_status")
}

/// 沙箱（会话容器）的生命周期状态（`02` §三 的 `status(CREATING|RUNNING|RECYCLED|FAILED)`，
/// P0-3-2 落地）。四个取值都是**终态/在态**混合，刻意不叫 ACTIVE/STOPPED：
/// · `CREATING` —— 行已建、容器可能还没建起来（`container_id` 此刻为 `NULL`）；
///   它是**在飞态**，对账器会给它一个宽限期（`SANDBOX_CREATE_GRACE_SEC`）才判死；
/// · `RUNNING` —— 容器已建并已启动（`container_id` 必有值）；
/// · `RECYCLED` —— 容器与具名卷已回收（用户停止 / 空闲超时 / 后端重启对账）；
/// · `FAILED` —— 创建中途失败（`error_msg` 给可读原因）。
/// ⚠️ **行只增不删**（与"消息与产物都不删"同口径）：一个会话可以有多行（回收后再发消息会新建容器）。
enum SandboxStatus {
  CREATING
  RUNNING
  RECYCLED
  FAILED

  @@map("sandbox_status")
}

// ───────────────────────────── 表 ─────────────────────────────

/// users —— 认证与用户（`02` §三 / §4.1 / §4.2）
///
/// 契约注意：
/// · `username` 的唯一性是**大小写敏感**的（PG 默认）。「登录时用户名大小写不敏感」
///   这层语义放在 P0-1-7 的 auth.service 里做（写入前统一小写归一），不进数据库约束 ——
///   加 citext 会让 Prisma 的 `@db.` 映射变复杂，收益不抵成本。
/// · `password_hash` 只存 bcrypt 摘要（P0-1-6 的 cost 12）；任何读接口都不得带出该列。
/// · `must_change_password` 建号即为 true（`02` §4.2「建号即必须改密」）。
model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  username           String     @unique @db.VarChar(64)
  passwordHash       String     @map("password_hash") @db.Text
  nickname           String?    @db.VarChar(64)
  role               UserRole   @default(MEMBER)
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  agents         Agent[]
  conversations  Conversation[]
  mcpServers     McpServer[]
  mcpCredentials McpCredential[]
  usageRecords   UsageRecord[]

  @@map("users")
}

/// model_providers —— 模型服务商（`02` §三 / §4.3）
///
/// `api_key_enc` 是 **AES-256-GCM 密文**（P0-1-6 的 infra/crypto 加解密，P0-1-10 写入）。
/// 可空：本系统允许无鉴权的自建 provider（如内网 vLLM / Ollama 兼容端点）。
/// `@@index([type, enabled])` 服务管理页按类型过滤的列表查询。
model ModelProvider {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String    @db.VarChar(128)
  baseUrl   String    @map("base_url") @db.Text
  apiKeyEnc String?   @map("api_key_enc") @db.Text
  type      ModelType
  /// 上游协议（P0-1-37）。默认 `OPENAI_COMPAT` ⇒ 既有行行为不变；见 `enum UpstreamProtocol`
  protocol  UpstreamProtocol @default(OPENAI_COMPAT)
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  models Model[]

  @@index([type, enabled])
  @@map("model_providers")
}

/// models —— 模型（`02` §三 / §4.3）
///
/// · `label` = 别名（界面上给业务同学看的名字），`model_name` = 上游真实型号名。
/// · `@@unique([providerId, modelName, type])`：同一 provider 下同型号同类型只应有一条。
///   带 `type` 是因为同一型号名可能既提供 chat 又提供 embedding（如 bge 系列的兼容端点），
///   不带 type 会把这种合法情况误判成重复。
/// · `@@index([type, enabled])`：服务 `GET /api/models?type=CHAT`（全员可选模型列表，
///   `enabled=false` 的必须筛掉 —— `01` §3.2「无效模型创建 Agent 时不可选」）。
/// · 删除语义 `onDelete: Cascade`：模型之于 provider 没有独立意义，provider 没了模型也留不住。
model Model {
  id             String    @id @default(uuid(7)) @db.Uuid
  providerId     String    @map("provider_id") @db.Uuid
  modelName      String    @map("model_name") @db.VarChar(128)
  label          String    @db.VarChar(128)
  type           ModelType
  maxContext     Int?      @map("max_context")
  supportsVision Boolean   @default(false) @map("supports_vision")
  // 是否支持"深度思考"（reasoning / thinking）。默认 false —— 与 supportsVision 同款：
  // 既是选模型侧的读数，也在对话链路上决定"是否向上游请求思考"（见 llm/protocol.ts 各协议 buildBody）。
  supportsReasoning Boolean @default(false) @map("supports_reasoning")
  enabled        Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider ModelProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  agents   Agent[]
  agentPool AgentModel[]

  @@unique([providerId, modelName, type])
  @@index([type, enabled])
  @@map("models")
}

/// agents —— Agent（`02` §三 / §4.4）
///
/// · `guideQuestions` 是 `string[]` 的 jsonb（引导问题，`01` §3.3）。默认 `[]` 而非 null，
///   前端可以无脑 `.map()`；写入端（P0-1-22）负责校验元素都是字符串。
/// · `modelId` **可空** + `onDelete: SetNull`（P0 优化：删智能体/删模型商自动解绑）：
///   删掉一个模型（含删 Provider 时其下模型级联删）时，DB 自动把引用它的 Agent 的
///   `model_id` 置空 —— Agent 保留但变成「未绑定模型」，需重新绑定后才能对话。
///   软删智能体时由服务层显式把 `model_id` 置空（SetNull 只在删模型那侧触发）。
///   运行期拿到 `model_id = null` 的 Agent，`resolveChatTarget` / 绑定校验会给可读 409，
///   而不是让「指向不存在模型」在库里出现。
///   ⚠️ `modelId` 的语义自"模型池"上线后收窄为**默认模型**（对话时不指定模型走它）；
///   可选的模型集合是 `pool`（{@link AgentModel}），默认模型**必须**是池成员（服务层保证）。
model Agent {
  id             String    @id @default(uuid(7)) @db.Uuid
  name           String    @db.VarChar(128)
  description    String?   @db.Text
  icon           String?   @db.VarChar(255)
  type           AgentType
  systemPrompt   String?   @map("system_prompt") @db.Text
  openingRemarks String?   @map("opening_remarks") @db.Text
  guideQuestions Json      @default("[]") @map("guide_questions") @db.JsonB
  modelId        String?   @map("model_id") @db.Uuid
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  model         Model?            @relation(fields: [modelId], references: [id], onDelete: SetNull)
  creator       User              @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  components    AgentComponent[]
  pool          AgentModel[]
  conversations Conversation[]
  usageRecords  UsageRecord[]

  @@index([deletedAt, updatedAt(sort: Desc)])
  @@index([createdBy])
  @@map("agents")
}

/// agent_models —— Agent 的**可选模型池**（对话时可在其中选具体模型）
///
/// 背景：原设计"Agent 绑定单一模型、运行时不可切换"（旧决策 9）在实际使用中很不方便。
/// 现在 Agent 绑定一个模型集合（池），发消息时可在池内选一个具体模型；请求不指定时
/// 走 `agents.model_id`（默认模型，服务层保证它是池成员）。
///
/// · `@@unique([agentId, modelId])` 防重复入池；
/// · `onDelete: Cascade` 两侧都成立：删 Agent（硬删/软删由服务层显式删行）、删模型
///   （含删 Provider 级联删模型）时，对应的池成员行随之消失。
///   ⚠️ 删模型只会移除"池成员"这一行，不会删 Agent 本身；若被删的恰好是默认模型，
///   `agents.model_id` 由既有的 `SetNull` 外键置空（Agent 变「未绑定模型」）。
model AgentModel {
  agentId   String   @map("agent_id") @db.Uuid
  modelId   String   @map("model_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@id([agentId, modelId])
  @@index([modelId])
  @@map("agent_models")
}

/// agent_components —— Agent 的组件绑定（`02` §三 / §4.4）
///
/// ⚠️ `refId` 是**多态外键**：`componentType=KNOWLEDGE` 时指向 `knowledge_bases.id`，
/// `MCP` 时指向 `mcp_servers.id`。因此**刻意不建 FK 约束**（一张列不能同时指向两张表），
/// 引用完整性由服务层保证（P0-1-23 的 PUT 全量替换）。知识库/MCP 表本身要到 P0-1-14
/// 与 P0-2 才建，本批也不具备建 FK 的条件。
///
/// `@@unique([agentId, componentType, refId])` 防重复绑定；`config` 预留给未来的
/// per-binding 参数（jsonb 可空，P0 不写）。
/// `onDelete: Cascade`：删绑定随 Agent 走；注意 Agent 是**软删**，软删时由服务层显式删绑定行。
model AgentComponent {
  id            String        @id @default(uuid(7)) @db.Uuid
  agentId       String        @map("agent_id") @db.Uuid
  componentType ComponentType @map("component_type")
  refId         String        @map("ref_id") @db.Uuid
  config        Json?         @db.JsonB
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, componentType, refId])
  @@map("agent_components")
}

/// conversations —— 会话（`02` §三 / §4.5）
///
/// · `topic` 可空：新建会话时前端还没输入内容，标题由首条用户消息兜底（`03` 前端负责）。
/// · `lastMessageAt` 是**列表排序键**（`01` §3.4「按最近活跃排序」），可空表示「还没有消息」；
///   两个 `@@index` 分别服务「我的会话列表」与「某 Agent 的会话列表」两种查询。
/// · `status` 的 FINISHED 用于 Agent 软删后把历史会话转只读（§4.4）。
/// · 删除语义全部 `Restrict`：会话是业务留痕，不允许因为删 Agent/用户而被动消失。
model Conversation {
  id            String             @id @default(uuid(7)) @db.Uuid
  agentId       String             @map("agent_id") @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  topic         String?            @db.VarChar(255)
  status        ConversationStatus @default(ACTIVE)
  lastMessageAt DateTime?          @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  agent    Agent     @relation(fields: [agentId], references: [id], onDelete: Restrict)
  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages Message[]
  /// 沙箱账本（P0-3-2）。⚠️ 删会话会**级联删掉这些行**，但容器不归数据库管 ——
  /// 孤儿回收器按 label 找容器、按"会话还在不在"判死（见 `backend/src/sandbox/reaper.ts`）。
  sandboxes Sandbox[]
  /// 本会话的产出文件（P0-3-7）。⚠️ 删会话会级联删行，但**对象与行的过期收口只由保留期
  /// 清理器做**（`02` §三"消息与产物都不删"指的是不跟会话/Agent 的删除走）
  artifacts Artifact[]

  @@index([userId, lastMessageAt(sort: Desc)])
  @@index([agentId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

/// messages —— 消息（`02` §三 / §4.5）**按月分区表**
///
/// ⚠️ 这张表在数据库里是 `PARTITION BY RANGE (created_at)`（`02` §三「分区说明」），
/// 于是有两处与普通表不同的约定，改本模型前务必先读：
///
/// 1. **主键必须是 `(id, created_at)`** —— PG 硬性要求分区键包含在主键/唯一约束里。
///    代价：`findUnique` 不能只给 `id`，要写复合键
///    `where: { id_createdAt: { id, createdAt } }`（Prisma 对 `@@id([a, b])` 生成的键名）。
///    业务上不亏：§4.5 的消息分页本来就带 `conversationId`，且排序键就是 `createdAt`，
///    所以游标查询天然能拿到这两个值（见下方 `@@index`）。
///
/// 2. **分区不在这里声明**（Prisma 没有分区语法）。分区父表/子表与后续月份分区的维护
///    全部在 `prisma/migrations/0001_init/migration.sql` 里用 SQL 完成，包括
///    `ensure_messages_partition(month)` 这个「建当月分区」的幂等函数。
///
/// `content` 的 jsonb 结构（`02` §三）：`{ text, thinking, tool_calls, citations, artifacts, attachments }`
/// （`artifacts` 段 P0-3-7 定型；`attachments` 仍属 P1 未定型），
/// 逐字段的 zod schema 属于 SSE 契约（P0-1-25），本批不定型 —— 但**结构一经写入不改语义**，
/// 因为历史消息要能被后续版本原样渲染。
/// `tokensIn/tokensOut` 可空：流被中断时也可能已产生 token，或 embedding/工具轮次无计量。
/// `onDelete: Cascade`：删会话必删其消息（§4.5「DELETE /api/conversations/:id」）。
model Message {
  id             String      @default(uuid(7)) @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  conversationId String      @map("conversation_id") @db.Uuid
  role           MessageRole
  content        Json        @db.JsonB
  tokensIn       Int?        @map("tokens_in")
  tokensOut      Int?        @map("tokens_out")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// ⚠️ 复合主键是分区的**前置条件**，不是设计偏好（见上方说明 1）
  @@id([id, createdAt])
  /// 会话内按时间倒序分页（`?beforeId=&limit=` 游标：先定位游标行拿 createdAt，再按此索引取）
  @@index([conversationId, createdAt(sort: Desc)])
  @@map("messages")
}

// ═══════════════════════════════════════════════════════════════════════════
// 知识库三表（P0-1-14）
//
// 依据：`docs/02-后端设计.md` §三 + §4.6、`docs/子方案/知识库流水线.md` §4-4（DDL 与索引）。
// 两条与其它表不同的地方，改这三张表之前务必先读：
//
// 1. **`chunks.embedding` 是 `Unsupported("vector(1024)")`** —— Prisma 不认识 pgvector 类型，
//    只能声明成「这个列存在，但别碰」。后果有两个，都是刻意的：
//      · 该列**不在生成的 client 里**，于是 chunks 的写入/检索一律走手写 SQL
//        （`子方案①` §4-4 的 `INSERT ... SELECT unnest(...)`、§6-1 的 `embedding <=> $1`）；
//      · 列可空（`?`）是硬性要求 —— 可空才能让 Prisma 侧的 `create` 省略它，否则
//        「模型里有必填的 unsupported 字段」会让整个模型无法建行（连造测试数据都不行）。
//        顺带这也与 `子方案①` §4-4 的 DDL 一致（那里也没有 NOT NULL）。
//
// 2. **chunks 的两个特殊索引，一个在本文件里声明、一个不能**（P0-1-14 的关键结论）——
//    Prisma 认不出的索引会被它当成"库里多出来的对象"并生成 `DROP INDEX`，
//    所以"手写 DDL"这件事在本批**必须**配一个不让 diff 归不了零的处置：
//      · 全文路的 GIN —— Prisma 能表达（`type: Gin` + `ops: raw(...)` + `map`），
//        因此**在本文件里声明**（见 Chunk 模型），Prisma 自己管它；
//      · 向量路的 HNSW —— Prisma 表达不了（`type: Hnsw` 直接报 Unknown index type，
//        且 `WITH (m, ef_construction)` 也没有语法位置），于是改为在迁移里建**部分索引**
//        （`WHERE kb_id IS NOT NULL`）：Prisma **忽略部分索引**（实测），
//        而该谓词恒真（`kb_id` 是 NOT NULL 列）且被向量路的 `kb_id = $2` 蕴含，
//        索引内容与全量 HNSW 等价、规划器照常使用。
//    两条机制都由验收脚本断言守着（`pnpm verify:knowledge`）：
//    它跑 `migrate diff --exit-code` 必须为 0，并用 `EXPLAIN` 证明两个索引真的被用上。
//    探针原始输出见 `issue_fix/问题记录-P0-1-14-知识库数据模型.md`。
//
// 主键类型沿用 `02` §3.1「一律 uuid(7)」。`子方案①` §4-4 的 DDL 草稿写的是 `bigserial`，
// 本批按 `02` §3.1 统一为 uuid(7)（时间有序，B-tree 写入近似追加），并把该草稿同步改掉 ——
// 两张文档对同一条 DDL 给出不同口径属于文档腐烂，必须消掉其一。
// ═══════════════════════════════════════════════════════════════════════════

/// knowledge_bases —— 知识库（`02` §三 / §4.6、`子方案①` §二）
///
/// · `embeddingModel` **NOT NULL**：本系统的库一旦建出来就必然要入库/检索，
///   而"用哪个 embedding 模型建的"是 `子方案①` §八「换模型重建路径」的唯一判据 ——
///   留 null 等于把"这个库到底能不能检索"变成运行期才知道的事。
///   取值 = `EmbeddingProvider.name()`（P0-1-13 的 `api:<模型名>` / `local:<目录名>`），
///   P0-1-15 建库时**快照**。代价是"embedding 未就绪时建不了库"，这是刻意的：
///   彼时建出来的库不可能完成入库（`config.embedding.apiReady=false` + 取用时硬报错）。
/// · `chunkSize` / `chunkOverlap` 是**独立列**（`02` §三 已定），其余检索参数收进
///   `retrievalConfig` jsonb —— 避免为每个调参加一列（`子方案①` §二 的口径）。
/// · `retrievalConfig` 的 DB 默认值是**完整形状**（不是 `{}`）：即便将来有代码路径绕过
///   服务层直接插行，读出来也是可用配置。读取端仍一律 `??` 补默认值（§二），两层兜底。
model KnowledgeBase {
  id             String   @id @default(uuid(7)) @db.Uuid
  name           String   @db.VarChar(128)
  description    String?  @db.Text
  embeddingModel String   @map("embedding_model") @db.VarChar(255)
  chunkSize      Int      @default(512) @map("chunk_size")
  chunkOverlap   Int      @default(64) @map("chunk_overlap")
  /// 形状见 `子方案①` §二：`{topK, score, mode, splitStrategy, rrfK, weights:{vector,fulltext}}`
  retrievalConfig Json    @default("{\"topK\":5,\"score\":0.3,\"mode\":\"HYBRID\",\"splitStrategy\":\"hybrid\",\"rrfK\":60,\"weights\":{\"vector\":1.0,\"fulltext\":1.0}}") @map("retrieval_config") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  documents Document[]

  @@map("knowledge_bases")
}

/// documents —— 知识库文档（`02` §三 / §4.6、`子方案①` §三/§七）
///
/// · `contentHash` = sha256(原始文件字节) 的十六进制（64 字符），**上传时就算**：
///   它是覆盖重建的判重依据（§七「`content_hash` 相同的重传 → 200 '内容未变化，已跳过'」），
///   也是 P0-1-17 worker 幂等校验的一半（另一半是 `status`）。
/// · 覆盖重建（§七）**不新建 documents 行** —— 所以文档 id 稳定，
///   引用与 `agent_components.ref_id` 的绑定都不受影响。
/// · `chunkCount` 默认 0 而非 null：`PARSING` 期间就是"当前有 0 个可用 chunk"，
///   前端不必区分 null 与 0（文档列表在 `PARSING` 态另给"更新中"提示，§七 的取舍）。
/// · `errorMsg` 只在 `FAILED` 时有值，内容是给用户看的可读原因（如"疑似扫描件"）。
/// · 删除 `onDelete: Cascade`：删库必删其文档（`02` §4.6「删除时级联清 chunks 与 S3 原文件」，
///   S3 部分由服务层在删行前后处理）。
model Document {
  id          String         @id @default(uuid(7)) @db.Uuid
  kbId        String         @map("kb_id") @db.Uuid
  fileKey     String         @map("file_key") @db.Text
  fileName    String         @map("file_name") @db.VarChar(255)
  status      DocumentStatus @default(PARSING)
  chunkCount  Int            @default(0) @map("chunk_count")
  errorMsg    String?        @map("error_msg") @db.Text
  contentHash String         @map("content_hash") @db.VarChar(64)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  kb     KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  chunks Chunk[]

  /// 文档列表（`GET /api/knowledge-bases/:id/documents`）按新建时间倒序；
  /// `kb_id` 前缀同时服务 §4-1 第 4 条的判重查询（`WHERE kb_id=? AND content_hash=?`，
  /// 单库千级文档下走前缀 + 过滤足够，不为它单独再开一条索引）
  @@index([kbId, createdAt(sort: Desc)])
  @@map("documents")
}

/// chunks —— 文档分块（`02` §三 / `子方案①` §4-4）
///
/// · **单表不分区**（02 §三 分区说明）：分区表无法建全局 HNSW 索引，
///   而"百万级 chunk 以内"单表 + HNSW 足够（`01` §1.3 的容量目标）。
/// · `seq` 是文档内序号（0 起），与 `docId` 组成 `@@index([docId, seq])` —— 它同时是
///   覆盖重建时 `DELETE FROM chunks WHERE doc_id=?` 与按序回读的索引，
///   并补上 `doc_id` 外键缺的那个索引（PG 不会为 FK 自动建索引）。
/// · `embedding` 见文件顶部说明 1（Unsupported + 可空）。
///   维度 1024 写死在 DDL 里 ⇒ 改维度走「新建 chunks_v2 → 双写 → 切检索 → 弃旧表」
///   （`子方案①` §八），不做 `ALTER COLUMN`。
/// · `meta` 存结构元数据：标题层级 / 页码（§4-1），以及 §八 用来判「模型是否换过」的
///   `embeddingName`。默认 `{}` 而非 null，读取端不必判空。
/// · ⚠️ `id` 由**客户端**生成（`@default(uuid(7))` 是 Prisma 侧默认值，不在 DB 层，
///   见 `02` §3.1 与 P0-1-5 的实测：函数型默认值不进 DDL）。因此 P0-1-19 的
///   `INSERT ... SELECT unnest(...)` **必须自带 id 数组**，不能指望 DB 兜底。
model Chunk {
  id        String                      @id @default(uuid(7)) @db.Uuid
  docId     String                      @map("doc_id") @db.Uuid
  kbId      String                      @map("kb_id") @db.Uuid
  seq       Int
  content   String                      @db.Text
  /// pgvector 列，DDL 里是 `vector(1024)`；Prisma 侧只作声明，读写走手写 SQL。
  /// 它的 HNSW 索引**不在本文件声明**（Prisma 表达不了），建在迁移里且刻意做成
  /// 部分索引 —— 理由与代价见本文件顶部说明 2。
  embedding Unsupported("vector(1024)")?
  meta      Json                        @default("{}") @db.JsonB
  createdAt DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)

  doc Document @relation(fields: [docId], references: [id], onDelete: Cascade)

  /// 检索的两条路都要先按 `kb_id` 收窄（`子方案①` §6-1：绑定某 Agent 的每个 KB 各查一次）
  @@index([kbId])
  /// 覆盖重建的删除 + 按序回读 + `doc_id` 外键所需的索引（见上方说明）
  @@index([docId, seq])
  /// 全文路的中文 bigram 倒排（`子方案①` §4-4）。三处都不是可选项：
  /// · `ops: raw("gin_bigm_ops")` —— `text` **没有**默认 GIN 算子类（连 pg_bigm 装上也不设默认），
  ///   不写算子类 PG 直接报 `data type text has no default operator class for access method "gin"`；
  /// · `type: Gin` —— 不写会按默认 btree 生成 `USING btree`，而 btree 走不了 `LIKE '%词%'`；
  /// · `map: "idx_chunks_bigram"` —— 不给名字时 Prisma 会叫它 `chunks_content_idx`，
  ///   于是**每次 diff 都想把它改名**（实测），迁移与库两边名字必须钉死。
  @@index([content(ops: raw("gin_bigm_ops"))], type: Gin, map: "idx_chunks_bigram")
  @@map("chunks")
}

// ═══════════════════════════════════════════════════════════════════════════
// MCP（P0-2-2；`02` §三 的 `mcp_servers`）
// ═══════════════════════════════════════════════════════════════════════════

/// MCP server 注册表（`02` §三；按 `06` §4.3 的 ⚠️ 补两列 `slug` / `updated_at`）。
///
/// 三条口径（细节与理由见 `shared/src/mcp.ts` 文件头）：
///   · **没有 owner 列的收窄** —— `created_by` 只作**留痕**、不参与权限判定
///     （`06` §4.2 的第五族：`/api/mcp/**` 全员可注册、人人可见，与知识库同族；
///     代价是"任何登录用户都能改/删别人注册的 server"，这是 `01` 决策 22 的推论）；
///   · `slug` 从 `name` 派生、**创建时生成后不再变**（它要进工具名前缀 `mcp_{slug}_{tool}`，
///     跟着改名会让历史消息里的 `content.tool_calls` 对不上真实调用）⇒ **刻意不加唯一约束**
///     （best-effort，见 `uniqueSlug()` 的注释：并发的同名注册不该有一个 500；
///     最终唯一性由 P0-2-6 的"工具名冲突加序号"保证）；
///   · `oauth_config` 是 P1 的字段（列先建出来免得再改表），**不进任何响应契约**
///     —— 下发一个恒为 `NULL` 的字段只会诱使前端写永远走不到的分支。
model McpServer {
  id               String          @id @default(uuid(7)) @db.Uuid
  name             String          @db.VarChar(128)
  /// 工具名前缀的派生名（小写 ASCII、≤32 字符；纯中文名回落 `server`）
  slug             String          @db.VarChar(32)
  /// Streamable HTTP 的**单一 URL**（不是 baseUrl + 路径拼接）
  endpointUrl      String          @map("endpoint_url") @db.VarChar(2048)
  authType         McpAuthType     @default(NONE) @map("auth_type")
  /// P1（OAuth 2.1）的配置载体；P0 恒为 `NULL`
  oauthConfig      Json?           @map("oauth_config") @db.JsonB
  /// 注册者定义的凭据参数模板（形状属 P0-2-2、深度校验属 P0-2-3）
  credentialSchema Json            @default("[]") @map("credential_schema") @db.JsonB
  /// `{ fetchedAt, tools:[…] }`；`NULL` = **从未成功拉过**（形状属 P0-2-5）
  toolCache        Json?           @map("tool_cache") @db.JsonB
  status           McpServerStatus @default(UNKNOWN)
  /// **注册者（= 所属人）**。⚠️ **P0-2-12 起它是权限判据** —— **改/删 = 注册者 + ADMIN**
  /// （判据的唯一实现是 `shared/src/mcp.ts#canEditMcpServer`；原注释"只作留痕、不参与权限判定"
  /// **已作废**）。本表**没有"转移所属人"的入口**（ownership 转让属 P1）。
  /// ⚠️ 它同时是**探测主语**：`POST /:id/test` 与 `GET /:id/tools` 用**他**的凭据连上游
  /// （`tool_cache` 是 server 级共享的 ⇒ 主语必须唯一确定，不能是"谁点的测试"）；
  /// 而 `tools/call` 仍用**调用者自己**的凭据。
  createdBy        String          @map("created_by") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  credentials McpCredential[]

  @@index([createdBy])
  @@map("mcp_servers")
}

/// 用户级凭据（P0-2-4；`02` §三 的 `mcp_credentials` + §九 的核心定制点）。
///
/// 三条口径（细节与理由见 `shared/src/mcp.ts` 文件头 ⑤ 与 `mcpCredential.service.ts`）：
///   · **一行 = (server, user) 一份**，`uniq(server_id, user_id)` 就是"每用户每 server 一份"的落点；
///   · `values` 是 jsonb `{ "<模板里的 key>": "v1.<iv>.<tag>.<ct>" }` —— **逐 key 一条独立密文**
///     （AAD 含 serverId + userId + key）。⚠️ "清空某个 key" = **把这个键删掉**，不是存空串
///     （存空串会得到一段结构合法的空密文，让"已配置"永远为真）。
///   · 权限收窄**全在 `user_id` 上**（不是角色）：任何登录用户只能读写自己的行，
///     ADMIN **也没有后门**（第四族同源）。所以本表**没有 `created_by`** ——
///     `user_id` 本身就是归属，再加一列留痕只会让人以为存在"代填"的入口。
model McpCredential {
  id        String   @id @default(uuid(7)) @db.Uuid
  serverId  String   @map("server_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// 加密后的值：`{ "<key>": "v1.<iv>.<tag>.<ct>" }`；键集 = 我填过的参数（空串不算有值）
  /// ⚠️ 列名带 `_enc` 是刻意的（与 `model_providers.api_key_enc` 同一条纪律）：
  ///    让"这一列是密文"在**库结构层面**就看得出来 —— 任何一条 `SELECT` 的结果都不该被当成明文用。
  ///    它只在 `mcpCredential.service.ts` 被读写；日志侧另有 `LOG_REDACT_PATHS` 兜底。
  valuesEnc Json     @default("{}") @map("values_enc") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// ⚠️ `Cascade`：server 被删时凭据**必须跟着消失**（它引用的模板都没了）；
  ///    这也让 `removeMcpServer` 的 `P2025` 兜底注释里那句"本表目前没有任何 CASCADE 子表"作废
  server McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  /// ⚠️ `Cascade` 是**兜底**而不是活路径：本仓的用户没有硬删除入口（只改 `status`），
  ///    真删用户时（运维/脚本）他的凭据也不该留成一个指向不存在用户的行
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@index([userId])
  @@map("mcp_credentials")
}

// ═══════════════════════════════════════════════════════════════════════════
// sandboxes（P0-3-2）
//
// 依据：`docs/02-后端设计.md` §三 + `docs/子方案/沙箱与引擎集成.md` §四 1 / §九 1。
// 生命周期（建 / 复用 / 空闲回收 / 上限排队 / 孤儿回收）在 `backend/src/sandbox/`。
// ═══════════════════════════════════════════════════════════════════════════

/// sandboxes —— 会话容器账本（P0-3-2）。
///
/// ⚠️⚠️ **这张表不是"哪些容器是我们的"的判据**（`子方案③` §四 1 原文）：
/// 判据**只有一处** = 容器/卷上的 label `doubulea.role=sandbox`。两处都要有，但分工不同：
///   · **label** 回答"这东西是不是我们的"（后端崩在"容器已建、行还没写"之间时，
///     表里没有它、而 label 在 —— 这正是"判据不能是这张表"的原话）；
///   · **本表** 回答"它**该不该活着**"（`RUNNING` / 宽限期内的 `CREATING`）+ 排障用的 `container_id`。
/// ⇒ 对账器判孤儿用的是这两个答案的组合，**不是**"表里没有就删"或"表里有就留"。
///
/// 三条口径：
/// · `containerId` **可空**：行先落（`CREATING`），容器后建 ⇒ 建行那一刻确实还没有 id
///   （见 `SandboxStatus` 注释）。写死 NOT NULL 会让"先建行"这条顺序无法实现；
/// · 一行 = **一次容器的生命周期**（不是"一个会话一行"）：同一会话被回收后再发消息会新建容器 ⇒ 多行
///   ⇒ **刻意没有** `uniq(conversation_id)`；"当前那个"由 `status=RUNNING` 定位；
/// · `lastActiveAt` **只有一个写入口** = `touchSandbox()`（引擎事件调一次，P0-3-5 接上）。
///   空闲回收的判据就是它（`子方案③` §二：判据是**最后一次引擎事件的时间**，不是 CPU 占用）。
///   ⚠️ 不能改用 `updatedAt`：`@updatedAt` 会被**任何**字段写入顺带推进 ⇒"回收"这个动作本身
///   也会刷新它，判据就不再是"引擎活动"了。
///
/// 删除语义：`Cascade`（会话硬删 ⇒ 账本跟着删）。**容器不跟着删** —— 数据库管不到 Docker ⇒
/// 那一刻容器成了孤儿、由回收器按 label 收掉。这是"两处都要有、判据只能有一个"的必然代价，
/// 写在这里而不是假装它不存在。
model Sandbox {
  id             String        @id @default(uuid(7)) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  /// 容器 id（`CREATING` 期间为 `NULL`）。⚠️ 留痕/排障用，**不是**归属判据（见上方）
  containerId    String?       @map("container_id") @db.VarChar(128)
  status         SandboxStatus @default(CREATING)
  /// 创建时用的镜像名（= `SANDBOX_IMAGE`）。留痕：换过镜像后仍能看出某个会话跑在哪一版上
  image          String        @db.VarChar(255)
  /// 失败原因（**给人看的**：按"用户能不能照着做点什么"写；连接串/堆栈只进日志）
  errorMsg       String?       @map("error_msg") @db.Text
  /// ⚠️ 由**调用方显式传入**（`manager.ts#createSandbox` 传同一个 `startedAt`），不要依赖这个默认值：
  /// 本机 PG 会话时区非 UTC 时，`@default(now())` 与 JS 侧边界相差一个时区偏移，会把宽限期放大 8 小时
  /// （见 `docs/02` 的"已知问题：timestamptz 与 Prisma 的时区偏移"）。默认值只是兜底。
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 最后一次**引擎事件**的时刻（见上方口径）。空闲回收的唯一判据
  lastActiveAt   DateTime      @default(now()) @map("last_active_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// 「这个会话当前有没有在跑的容器」（复用判定 + 对账器的活体判定）
  @@index([conversationId, status])
  /// 空闲回收的扫描键：`status = RUNNING AND last_active_at < 阈值`
  @@index([status, lastActiveAt])
  @@map("sandboxes")
}

/// artifacts —— TaskAgent 产出文件（`02` §三 / §4.8；P0-3-7 落地）
///
/// ⚠️ **先传对象、再建行**（`子方案③` §十一 3：顺序不能反 —— 先建行会出现
/// "列表里有个文件、点下载才发现对象不存在"）。行是"下载/预览"的唯一入口（P0-3-9），
/// `fileKey` 不出现在任何对外契约里（对外只有 `id`，见 `shared#artifactItemSchema`）。
///
/// ⚠️ **产物不跟会话走**：`02` §三 的"消息与产物都不删"—— 删会话会级联删行，但
/// 过期收口**只由保留期清理器做**（`sandbox/artifacts.ts#reapExpiredArtifacts`，
/// `ARTIFACT_RETENTION_DAYS` 默认 7 天），不存在"会话一删文件就没了"的路径。
model Artifact {
  id String @id @default(uuid(7)) @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  /// S3 对象键：`artifacts/{conversationId}/{uuid}/{安全化的文件名}`（uuid 是存储层随机段，
  /// 与 `document.service.ts` 的 `kb/...` 键同一条纪律：对象名不需要有序）
  fileKey String @map("file_key") @db.VarChar(512)
  /// 容器内相对 `/work` 的路径（子目录产物就是 `out/report.csv` 这种形态）
  fileName String @map("file_name") @db.VarChar(512)
  /// 字节数（扫描时从 `find` 读到；上传用的 buffer 长度与之不一致时以实际读到的为准并 warn）
  size Int
  /// ⚠️ 产物 `Content-Type` 的**唯一来源**（`子方案④` §四）：P0-3-7 扫描时按扩展名定一次，
  /// 下载/预览端点不再看对象元数据、前端不看文件名后缀
  mime String @db.VarChar(255)
  /// 预览就绪标记（P0-3-10 才有消费者；P0-3-7 恒写 `false`，列先按 `02` §三 落上）
  previewReady Boolean @default(false) @map("preview_ready")
  /// ⚠️ 由**调用方显式传入**（`artifacts.ts` 写行时传 JS 侧 `new Date()`）：本机 PG 会话
  /// 时区非 UTC 时 `@default(now())` 与 JS 侧边界相差一个时区偏移，而保留期清理
  /// （`createdAt < now - N 天`）正是 JS 侧边界比较 —— 写偏了保留期就整体偏一个时区。
  /// 默认值只是兜底（同 `Sandbox.createdAt` 的口径）。
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// P0-3-9 的产物列表（`GET /:id/artifacts`）扫描键
  @@index([conversationId, createdAt(sort: Desc)])
  /// 保留期清理器的扫描键（`createdAt < now - ARTIFACT_RETENTION_DAYS`）
  @@index([createdAt])
  @@map("artifacts")
}

/// usage_records —— 计量（`02` §三 / §七 的「计量」那一行；`01` 决策 20。**P0-3-12 落地**）
///
/// **一行 = 一轮 TaskAgent 派活的用量**（不是"一次上游调用一行"，也不是"一个会话一行"）。
///
/// ─────────────────────────────────────────────────────────────────────
/// ★ 这张表为什么在 P0-3-12 就上线（原计划属 P1）
/// ─────────────────────────────────────────────────────────────────────
/// `02` §6.2 ⑦ 的"本版本不写 `usage_records`"是 **ChatBot 侧**（P0-1-27）的口径；
/// 而 `子方案③` §十 要求 **TaskAgent** 写它 —— 「引擎有 usage 则填满；无则 token 字段为空、
/// 按时长 + 轮次记条目」（`01` 决策 20）。这处张力在 P0-3-12 收口，于是**该表随本批上线**。
/// ⚠️ **ChatBot 仍不写**（它的接回点已就位：`persist.ts#PersistRoundInput.usageRecord`，
/// P1 只需在 `chatBot.ts` 传一次）—— 别把"表上线了"顺手理解成"两边都开始写"。
///
/// ─────────────────────────────────────────────────────────────────────
/// ★ 两列不由 `02` §三 的原始清单给出，而是本批按 `01` 决策 20 补的
/// ─────────────────────────────────────────────────────────────────────
/// `02` §三 的列清单是 `id, user_id, agent_id, model, tokens_in, tokens_out, created_at`。
/// 决策 20 允许"token 字段为空"，但要求那时**按时长 + 轮次**记 —— 没有这两列，
/// 兜底路径留下的就是一个"零信息量的行"（只有 id 与时间）。故补：
///   · `duration_ms` —— 本轮派活的墙钟耗时（我们**自己量的**，与引擎上报无关）
///   · `rounds`      —— 引擎这一轮跑了几轮（`turn_start` 条数）
/// ⚠️ `rounds` 的量纲是**引擎的 turn**，不是我们的"消息轮"：pi `how-pi-works.md` 的
/// "…That completes one turn. If tool results … require another model request, Pi starts
/// another turn." ⇒ **一个 turn = 一次模型请求**（= ChatBot 侧 `sumUsages` 相加的那一轮）。
///
/// ─────────────────────────────────────────────────────────────────────
/// ★ 分区表的四条约束（与 `messages` 同款，改本模型前务必先读）
/// ─────────────────────────────────────────────────────────────────────
/// 1. **主键必须含分区键** ⇒ `@@id([id, createdAt])`，`findUnique` 要写复合键
///    `where: { id_createdAt: { id, createdAt } }`。本表的读取形态是"按时间窗口 + 用户/Agent
///    聚合"，天然带 `createdAt`，所以不亏（同 `Message` 的说明）。
/// 2. **分区不在这里声明**：父表/子表与 `ensure_usage_records_partition(month)` 全在
///    `prisma/migrations/<ts>_add_usage_records/migration.sql` 里用 SQL 完成。
/// 3. **`tokens_*` 可空且刻意不用 0 代替**："引擎没上报"与"这一轮真的用了 0 个 token"
///    是两件事（`shared/src/sse.ts` 文件头 ④ 的同一条口径）—— 不知道就留 `NULL`。
/// 4. **时间为 JS 侧写入**（同 `Artifact.createdAt` 的理由）：本机 PG 会话时区非 UTC 时
///    `@default(now())` 与 JS 侧边界差一个时区偏移；本表的"按月看用量"正是 JS 侧窗口比较。
///    默认值只是兜底。
///
/// **删除语义 `Restrict`**（与 `conversations.user_id` / `conversations.agent_id` 同款）：
/// 计量是**账**，不该被谁连带删掉。本系统不删用户（见 `UserStatus` 注释），Agent 是软删
/// ⇒ 这两条外键在 P0 永远不会挡下一次合法操作，但它把"以后谁想硬删"这件事变成一次显式决定。
///
/// ⚠️ **刻意没有 `conversation_id`**：`01` 决策 20 的用途是"**按用户/Agent 的 token 累计**"，
/// 会话维度不在其中；加了它反而会诱导"删会话时要不要级联删账"这种本不该存在的问题
/// （`messages` 是 CASCADE，那是"历史属于会话"；账不是）。
model UsageRecord {
  id         String   @default(uuid(7)) @db.Uuid
  /// ⚠️ 由**调用方显式传入**（`orchestrator/persist.ts` 传 JS 侧 `new Date()`），见上方口径 4
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  userId     String   @map("user_id") @db.Uuid
  agentId    String   @map("agent_id") @db.Uuid
  /// 上游真实型号名（`LlmTarget.modelName`，如 `gpt-4o-mini`）。**刻意不是 `models.id`**：
  /// 报表要的是"哪个型号花了多少"（型号名才是跨 provider 的可比口径），而模型行可以被停用/改绑；
  /// 长度 255 与 `models.model_name`(128) 刻意不同 —— 这里存的是**上游报文里的那个名字**
  /// （`responseModel` 可能比登记的名字长），不跟着 `models` 的约束走。
  model      String   @db.VarChar(255)
  /// 引擎上报的输入/输出 token（跨 turn **相加**后的值）。`NULL` = 引擎没上报（不编 0）
  tokensIn   Int?     @map("tokens_in")
  tokensOut  Int?     @map("tokens_out")
  /// 本轮派活的墙钟耗时（`startedAt` → 落库前），**我们自己量的**
  durationMs Int      @map("duration_ms")
  /// 引擎这一轮跑了几轮（`turn_start` 条数 = 模型请求次数）；`0` = 引擎一次都没开轮
  rounds     Int

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Restrict)

  /// ⚠️ 复合主键是分区的**前置条件**，不是设计偏好（见上方口径 1）
  @@id([id, createdAt])
  /// 「某个用户的用量」（`02` §三 的用途：按用户累计）—— 时间窗口 + 人是必然的查询形状
  @@index([userId, createdAt(sort: Desc)])
  /// 「某个 Agent 的用量」—— TaskAgent 的用量尤其要能按 Agent 归集
  @@index([agentId, createdAt(sort: Desc)])
  /// ⚠️ **刻意没有 `@@index([createdAt])`**：分区表上的索引是**分区本地**的，
  /// "某段时间的全局用量"由分区裁剪（partition pruning）完成，再挂一个时间索引只增写放大。
  /// ⚠️ 也**刻意没有 `@@index([model])`**：按型号聚合是 P1 报表的事，届时按实际查询形状再加。
  @@map("usage_records")
}
