{
  "name": "@doubulea/backend",
  "version": "0.1.0",
  "private": true,
  "description": "后端服务：Fastify + Prisma（独立构建 → backend/dist）",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "watch:types": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "build": "pnpm run db:generate && tsc -p tsconfig.json",
    "start": "node dist/backend/src/index.js",
    "config:check": "pnpm run build && node dist/backend/src/index.js --check-config",
    "ocr:regression": "node --import tsx scripts/ocr-regression.ts",
    "caption:regression": "node --import tsx scripts/caption-regression.ts",
    "doc:sniff": "node --import tsx scripts/doc-sniff-regression.ts",
    "cron:regression": "node --import tsx scripts/cron-regression.ts",
    "notify:regression": "node --import tsx scripts/notify-regression.ts",
    "memory:regression": "node --import tsx scripts/memory-extract-regression.ts",
    "frame-bus:regression": "node --import tsx scripts/frame-bus-regression.ts",
    "build:shared": "pnpm --filter @doubulea/shared build",
    "typecheck": "pnpm run db:generate && tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:partitions": "prisma db execute --file prisma/sql/ensure_messages_partitions.sql && prisma db execute --file prisma/sql/ensure_usage_records_partitions.sql",
    "db:seed": "pnpm run db:generate && tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@doubulea/shared": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@modelcontextprotocol/client": "^2.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "dockerode": "^5.0.1",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "mammoth": "^1.12.3",
    "minio": "^8.0.7",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3"
  }
}
