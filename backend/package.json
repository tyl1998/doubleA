{
  "name": "@doubulea/backend",
  "version": "0.1.0",
  "private": true,
  "description": "后端服务：Fastify + Prisma（独立构建 → backend/dist）",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/backend/src/index.js",
    "config:check": "pnpm run build && node dist/backend/src/index.js --check-config",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@doubulea/shared": "workspace:*",
    "pino": "^10.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.6.3"
  }
}
