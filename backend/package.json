{
  "name": "@doubulea/backend",
  "version": "0.1.0",
  "private": true,
  "description": "后端服务：Fastify + Prisma（独立构建 → backend/dist）",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "watch:types": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "build": "pnpm run db:generate && tsc -p tsconfig.json",
    "start": "node dist/backend/src/index.js",
    "config:check": "pnpm run build && node dist/backend/src/index.js --check-config",
    "verify:app": "pnpm run build && node scripts/verify-app.mjs",
    "verify:db": "pnpm run build && node scripts/verify-db.mjs",
    "verify:session": "pnpm run build && node scripts/verify-session.mjs",
    "typecheck": "pnpm run db:generate && tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:partitions": "prisma db execute --file prisma/sql/ensure_messages_partitions.sql",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@doubulea/shared": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "minio": "^8.0.7",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3"
  }
}
