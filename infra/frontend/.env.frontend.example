# ═══════════════════════════════════════════════════════════════════════
# 前端静态站点（P1-14 · R1）—— 复制成 `infra/frontend/.env.frontend`（gitignore）
# ═══════════════════════════════════════════════════════════════════════

# 镜像 tag（`pnpm frontend:build-image` 会打印；与后端/网关共用层版本号）
FRONTEND_IMAGE=doubulea-frontend:2

# 浏览器看到的端口
FRONTEND_PORT=8080

# ★ 路由网关的可达地址（**不是**业务后端：绕过网关 = 没有粘性、没有负载感知）
ROUTER_UPSTREAM=http://10.73.100.153:13100

# 上传上限（MB），与后端 FILES_MAX_MB 同量级
CLIENT_MAX_BODY_MB=100
