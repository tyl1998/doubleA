# ═══════════════════════════════════════════════════════════════════════
# 环境变量样例 —— 复制为 infra/.env 后按需修改
#
#   PowerShell:  Copy-Item infra/.env.example infra/.env
#
# ⚠️ 本文件是**唯一的环境变量真相来源**（模板）。后端 `backend/src/config.ts`（P0-1-3 已落地）
#    用 zod 按此清单校验：缺少必填项时**启动直接失败**并打印缺失清单（含怎么修）。
#
#    后端加载顺序（12-factor）：先读本文件 → 但**不覆盖**进程里已存在的变量，
#    所以 shell / 容器 / CI 注入的值优先。两个调试开关（进程环境变量，不写在本文件）：
#      DOUBULEA_ENV_FILE=/path/to/.env   指定另一个 env 文件
#      DOUBULEA_SKIP_ENV_FILE=1          完全不读 env 文件（只校验进程环境）
#    自检命令：pnpm config:check         只校验并打印脱敏后的生效配置
#
# 分组依据：
#   [A] compose 自身用的变量 —— 由 docker compose 读取，控制端口与初始账号
#   [B] 应用配置 —— 后端进程读取；开发期由 infra/scripts/dev-up.ps1 汇总输出，
#       P0-1-3 起由 backend 直接读（届时 app 若入 compose 则同源）
# 变量全集来源：docs/02 §十一（配置）+ docs/子方案/知识库流水线.md §十一（增量）
# ═══════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────
# [A] compose 用：宿主端口映射（冲突时只改这里）
# ─────────────────────────────────────────────────────────────────────
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
TZ=Asia/Shanghai

# ─────────────────────────────────────────────────────────────────────
# [A] PostgreSQL 初始账号（**只在空数据卷首次初始化时生效**）
#     改这几项后若要生效，必须先 dev-down.ps1 -Purge 清空卷再起。
# ─────────────────────────────────────────────────────────────────────
POSTGRES_USER=doubulea
POSTGRES_PASSWORD=CHANGE_ME_local_dev_pwd
POSTGRES_DB=doubulea

# ─────────────────────────────────────────────────────────────────────
# [A] MinIO 初始账号（同理，改动需重建数据卷）
#     ⚠️ 密码长度 ≥ 8，否则 MinIO 拒绝启动
# ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=doubulea
MINIO_ROOT_PASSWORD=CHANGE_ME_local_dev_pwd

# ─────────────────────────────────────────────────────────────────────
# [B] 后端必填（apps config.ts 缺任一即启动失败）
# ─────────────────────────────────────────────────────────────────────

# PG 连接串。注意：容器内互访主机名是 `postgres`；宿主进程访问走 127.0.0.1 + POSTGRES_PORT。
# 开发期（后端跑在宿主）用 127.0.0.1；P0-3 生产形态改为 postgres。
DATABASE_URL=postgresql://doubulea:CHANGE_ME_local_dev_pwd@127.0.0.1:5432/doubulea?schema=public

# Redis 连接串
REDIS_URL=redis://127.0.0.1:6379

# 对象存储（S3 兼容）。开发期指向宿主映射的 MinIO。
S3_ENDPOINT=http://127.0.0.1:9000
S3_KEY=doubulea
S3_SECRET=CHANGE_ME_local_dev_pwd
S3_BUCKET=doubulea

# 凭据加密主密钥（MCP 用户级凭据用，docs/02 §九）：**必须 32 字节的 base64**
# 生成：openssl rand -base64 32     或   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ 一旦有数据写入就**不能改**，否则已加密凭据全部解不开。
CREDENTIAL_MASTER_KEY=

# ─────────────────────────────────────────────────────────────────────
# [B] embedding 双模式（决策 26 / docs/02 §八）
# ─────────────────────────────────────────────────────────────────────
# local = 本地 onnx 推理 bge-m3 int8（默认，纯内网可用）；api = OpenAI 兼容接口
EMBEDDING_MODE=api
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=
LOCAL_EMBEDDING_MODEL_PATH=/models/bge-m3-int8
# local 模式的**推理运行时**模块（P0-1-13）：导出 createEmbedder({ modelPath, dim })，
# 契约见 docs/02 §八。为空即"local 模式尚未就绪"（bge-m3 交付物形态见 docs/06 §七 待决事项 2）。
LOCAL_EMBEDDING_RUNTIME_MODULE=
# 一次 embedding 请求的文本条数（子方案① §4-3 的 chunk_embed_batch；P0-1-15 建库时快照进 KB）
EMBEDDING_BATCH_SIZE=32
# 与 chunks.embedding 的 vector(1024) 必须一致（子方案① §4-4）
EMBEDDING_DIM=1024

# ─────────────────────────────────────────────────────────────────────
# [B] 并发与限额（docs/02 §十一）
# ─────────────────────────────────────────────────────────────────────
CHATBOT_CONCURRENCY=50
PIPELINE_CONCURRENCY=2
UPLOAD_BODY_LIMIT=100MB
SSE_PING_INTERVAL_SEC=20
CONTEXT_ROUNDS=20
TOOL_LOOP_LIMIT=30
ARTIFACT_URL_TTL_MIN=30

# ─────────────────────────────────────────────────────────────────────
# [B] 沙箱与产物（P0-3-1 首次落地；参数总表 = docs/子方案/沙箱与引擎集成.md §二）
#     ⚠️ P0-3-1 只构建镜像；消费方逐批接上：P0-3-2（容器生命周期/配额/回收）、
#        P0-3-3（✅ 网络两出口 + 容器加固 + 卷体量巡检）、P0-3-4（Key 注入）、P0-3-7（产物扫描/保留期）。
#     ⚠️ 数值以 `子方案③` §二 为准，代码里不硬编码散落（docs/06 §六 第 4 条）。
# ─────────────────────────────────────────────────────────────────────
# 沙箱并发上限（决策 8）。⚠️ **作用域 = 单个后端实例**，不是"整个平台"（子方案③ §九 3）
SANDBOX_CONCURRENCY=10
# 空闲回收（分钟）。判据是**最后一次引擎事件的时间**，不是 CPU 占用
SANDBOX_IDLE_TTL_MIN=30
# 单容器内存上限（MB）。**主限额** —— 10 并发的真实瓶颈是内存，不是核
SANDBOX_MEM_LIMIT_MB=2048
# 单容器 CPU 上限（核）。为辅：只防单容器跑飞拖垮宿主 ⇒ **可以是小数**
SANDBOX_CPU_LIMIT=1.5
# 单容器进程数上限。防 fork 炸弹；但 pandas / node 都要开子进程，别给小
SANDBOX_PIDS_LIMIT=512
# work 卷的**告警阈值**（MB）。⚠️ 它**不是硬配额**（P0-3-3 实测两条）：
# ① `--storage-opt size=` 需要 overlay2 + xfs + pquota，本机守护进程**直接拒绝**（写进创建参数
#    的话建容器这一步就失败）；② 即使换了文件系统，它管的是**容器可写层**、管不到**具名卷**。
# ⇒ 降级方案 = `reaper.ts#auditWorkVolumes` 周期巡检 + 超限告警 + 人工介入，**不假装有配额**
SANDBOX_WORK_VOLUME_MB=1024
# 容器 `/tmp`（tmpfs，nosuid,nodev,noexec）。只放小临时文件，大产物落 work 卷
SANDBOX_TMPFS_MB=64
# 沙箱代理 listener 端口（**内网**，只有沙箱专用 bridge 可达）。
# ⚠️ 与 `BACKEND_PORT`（本机 13000）**分开**，不要顺手写成 13000
SANDBOX_CALLBACK_PORT=13001
# per-container token 长度（字符）：43 = `randomBytes(32)` 的 base64url，与会话令牌同规格
SANDBOX_TOKEN_LEN=43
# 容器侧调代理的超时（秒）。⚠️ **必须 > MCP_CONFIRM_TIMEOUT_SEC**（否则用户在确认卡上
# 点确认时容器已经放弃）；这条跨字段约束由 config.ts 的 superRefine 守着
SANDBOX_PROXY_TIMEOUT_SEC=180
# 沙箱出公网的 egress 代理（只放行模型池 baseURL，子方案③ §四 3 出口①）。
# ✅ P0-3-3 定案：落成 **HTTP 代理 + 容器环境变量**（源码级实测：pi 装的是
#    `undici.EnvHttpProxyAgent`，它自己读 HTTP_PROXY / HTTPS_PROXY / NO_PROXY；
#    pi 的设置项 httpProxy 只是 `process.env.HTTP_PROXY ??= <值>` ⇒ 环境变量优先）。
# ⚠️ 仍留空 = 可选，但**没配它时 `ensureSandbox()` 会拒绝建容器**（容器在专用 internal
#    bridge 上没有公网路由 ⇒ 必然调不到模型池）。要让沙箱跑起来就得把它填上。
# ✅ 本机开发用一个命令就行（起一个"两条腿"的代理容器，并把本行自动填好）：
#      bash infra/scripts/egress-up.sh --write-env
#    ⚠️ 顺序：沙箱网络由后端启动时的 listener 建出来 ⇒ 先 `pnpm dev`，再跑上面这条。
#    白名单默认取库里 enabled 的 model_providers 主机名（空名单 = 拒启，不是全放行）。
SANDBOX_EGRESS_PROXY_URL=
# 【容器眼里】后端沙箱代理的地址（出口②）。
# 留空 = 自动取「专用 bridge 的网关地址 + SANDBOX_CALLBACK_PORT」——那是后端与 Docker
# 同宿主的形态（= 生产）。⚠️ macOS（OrbStack / Docker Desktop）上 Docker 跑在 VM 里，
# 容器到不了跑在 macOS 上的后端 ⇒ 那时把它显式指到一个与沙箱网络双宿的中转地址
# （例：http://doubulea-sandbox-relay:13001）。**不猜、不兜底**（docs/06 §六 27）
SANDBOX_BACKEND_URL=
# 沙箱代理 listener 的**绑定地址**。留空 = 专用 bridge 的网关地址（只有该 bridge 内的
# 容器可达 —— 暴露面收敛是刻意的）。macOS 那类"后端不在 Docker 宿主上"的部署填 0.0.0.0
SANDBOX_LISTEN_HOST=
# 沙箱**排队队列**的 Redis 键（P0-3-2）。理由同 PIPELINE_QUEUE_KEY：REDIS_URL 是共享的，
# 而队列是**被消费**的资源 ⇒ 同机两个进程用同一个键时"谁取走"是随机的，症状是"时好时坏"。
# 可换键 = 可隔离消费方
SANDBOX_QUEUE_KEY=sandbox:queue
# 排队项存活时长（秒，P0-3-2）。**两个语义共用一个数（刻意）**：
# ① 这条排队项什么时候算孤儿（对应它的 SSE 流已经断了）；② 等待预算（等这么久就报超时）
SANDBOX_QUEUE_TTL_SEC=600
# 周期对账（孤儿回收 + 空闲回收）间隔（秒，P0-3-2）。定成配置项是为了**能注入小值**去验
# "等它回收"这条断言；60 秒是"人工操作也有机会看到结果"与"不空转"之间的折中
SANDBOX_REAP_INTERVAL_SEC=60
# `CREATING` 行的宽限期（秒，P0-3-2）。⚠️ **必须 > SANDBOX_REAP_INTERVAL_SEC**（config.ts 守着）：
# 宽限期若短于检查周期，一次"正在创建"的沙箱会被对账器判成孤儿删掉（症状：偶尔起来就被删）
SANDBOX_CREATE_GRACE_SEC=120
# 产物单文件上限（MB）；超出记**告警并跳过**，不静默丢
ARTIFACT_MAX_FILE_MB=50
# 单轮产物扫描的文件数上限；超出即截断并告警（防引擎写一万个小文件打爆上传）
ARTIFACT_SCAN_MAX_FILES=200
# 产物**文件**在对象存储的保留期（天）。
# ⚠️ 与 `ARTIFACT_URL_TTL_MIN`（下载**链接** 30 分钟）是**两件事**：前者是文件的寿命、
# 后者是链接的时效。不定这个数，产物就是一个只涨不跌的口子
ARTIFACT_RETENTION_DAYS=7
# ── 定时任务（P1-6，2026-10-09 需求变更：任务中心 = 定时任务）──
# 调度器 tick 间隔（秒）。cron 最小粒度是分钟，30s 够用且不空转；调小只在自测"到点触发"时需要
SCHEDULED_TASK_TICK_SEC=30
# 单次运行的墙钟上限（分钟）：无人值守没有"用户点停止"，超时即中断（否则卡住的引擎一直占沙箱名额）
SCHEDULED_TASK_RUN_TIMEOUT_MIN=30
# 一轮 tick 最多处理多少条到期任务（防积压时一次性拉起过多运行打爆沙箱）
SCHEDULED_TASK_MAX_DUE_PER_TICK=20
# 通知 webhook（企微/飞书等）的单次请求上限（毫秒）；超时只记 warn，不拖垮那一轮
NOTIFY_TIMEOUT_MS=10000
# 沙箱镜像。⚠️ `SANDBOX_IMAGE` = **最终镜像 = toolkit 层**；`SANDBOX_IMAGE_BASE` 是 base 层
# （toolkit 的 `FROM`）。两个值都由 `pnpm sandbox:build` 在末尾直接打印出来，照抄即可
# ⚠️ **P0-3-4 起层版本是 `:2`**（base 与 toolkit 两层都变了）——镜像内容改了就必须重建 + 换版本号，
#    否则宿主上会同时留着新旧两个 tag，"上次构建的"与"这次跑的"就此分叉（症状：入口没有
#    `gen-models.mjs` 那一步 ⇒ 容器里没有 `models.json`、引擎不知道调哪个模型）
SANDBOX_IMAGE=
SANDBOX_IMAGE_BASE=

# ─────────────────────────────────────────────────────────────────────
# [C] LLM 调用超时（P0-1-12 起生效；消费方只有 backend/src/llm/client.ts）
# ─────────────────────────────────────────────────────────────────────
# 「到响应头」的上限（毫秒）：连接 + TTFT。三种路径的处置不同 ——
#   流式：**收到响应头就撤掉**（之后交给下面的空闲超时），否则长回答会被它腰斩；
#   非流式：覆盖"发请求 + 读 body"全程（报文很小，不必再开一个计时器）；
#   拉取上游模型列表（GET /models）：同上。
# ⚠️ 它**不是**整个对话的上限。要让"上游挂了"快速失败、而不是让界面一直转圈，靠的是它。
LLM_REQUEST_TIMEOUT_MS=30000
# 流式响应体「两次数据之间的间隔」上限（毫秒）；每收到一块即重置。
# 比上面大得多是刻意的：思考型模型首字之后常有长静默期（静默期里多数实现也会发心跳行，
# 那同样算"收到数据"）。真出现 2 分钟一个字节都没有，基本可以断定连接已死。
LLM_STREAM_IDLE_TIMEOUT_MS=120000

# ─────────────────────────────────────────────────────────────────────
# [C] MCP 客户端（P0-2-1 起；`docs/02` §4.7 / `docs/06` §四 4.3）
# ─────────────────────────────────────────────────────────────────────
# 协议与传输：只做 **Streamable HTTP** + JSON-RPC 2.0；`stdio` 传输与 OAuth 2.1 不在 P0 范围。
# ⚠️ 协议版本由官方 SDK 自带**版本协商**决定，没有配置项：
#    SDK 1.30.1 请求写死 `2025-11-25`（LATEST_PROTOCOL_VERSION，无 setter），
#    服务端可以回一个它支持的更低版本。本仓的设计目标是 `2025-06-18`
#    （`docs/06` §四 4.0 全局口径 1）；服务端回它时 SDK 会接受，
#    并且此后每个请求都带 `mcp-protocol-version: 2025-06-18`。
#    握手时会把「请求版本 / 协商版本 / 是否落回设计目标」记进日志（info 级）。
#    服务端若回一个 SDK 不支持集之外的版本，直接 502 并在消息里列出支持集。
#
# 单次请求的上限（毫秒）：到响应头 / `tools/call` 的等待共用它。
# 比 LLM 的 30s 小是刻意的 —— MCP 调用是"一问一答"的短事务，不是整段流式生成。
# ⚠️ 交付验收要靠注入一个小值（如 700）来验超时分支，所以它必须是配置项。
MCP_REQUEST_TIMEOUT_MS=20000
# 危险工具调用等用户确认的上限（秒），超时按**取消**处理。
# ⚠️ P0-2-1 只登记不消费；消费方是 P0-2-10（确认流）。
MCP_CONFIRM_TIMEOUT_SEC=120
# 单个 MCP server 进 function 列表的工具数上限；超限**截断并告警**。
# ⚠️ P0-2-1 只登记不消费；消费方是 P0-2-6（inputSchema → OpenAI function 转换）。
MCP_TOOL_LIMIT=64

# ─────────────────────────────────────────────────────────────────────
# [B] 知识库流水线默认值（子方案① §十一；KB 建库时快照，此后独立可改）
# ─────────────────────────────────────────────────────────────────────
CHUNK_SIZE_DEFAULT=512
CHUNK_OVERLAP_DEFAULT=64
EMPTY_TEXT_THRESHOLD=50
RRF_K=60
RETRIEVAL_TOPK_DEFAULT=5
RETRIEVAL_SCORE_DEFAULT=0.3
CANDIDATE_POOL_FACTOR=3
# 流水线队列的 Redis 键（P0-1-17）。队列是"被消费"的资源：两个进程（dev server 与验收脚本、
# 或同机两套部署）用同一个键时，谁取走 job 是随机的 —— 症状是"验收时有时无"而不是报错。
# 改这个键即可隔离消费方（验收脚本会注入一个独立的键）。
PIPELINE_QUEUE_KEY=pipeline:jobs

# ─────────────────────────────────────────────────────────────────────
# [B] 文档图片解析（上传时按文档选择 NONE / OCR / MULTIMODAL）
# ─────────────────────────────────────────────────────────────────────
# 单张图片上限（超出则跳过该图，不因一张大图撑爆内存 / base64 长度）
IMAGE_MAX_BYTES=10MB
# 单篇文档最多处理的图片数（防止"一本图册"把 OCR / 向量化拖成分钟级）
IMAGE_MAX_COUNT=50
# 本地 OCR（tesseract.js）语言：`+` 或 `,` 分隔。
# ⚠️ 默认单语言 chi_sim，不要随意与 eng 混用（P1-10 实测：多语言会互相劣化，中文会被英文模型
#    带成 latin 乱码）；确需纯英文场景时才设为 eng。
OCR_LANGS=chi_sim
# OCR 语言包目录（离线/内网部署必须指向本地的 *.traineddata；留空则用 tesseract.js 默认从 CDN 拉取）
OCR_LANG_PATH=
# OCR 缓存目录（留空则由 tesseract.js 默认处理）
OCR_CACHE_PATH=
# tesseract 页面分割模式（tessedit_pageseg_mode）：6=整页单栏（默认），稀疏文本/截图可设 11
OCR_PSM=6
# 交给 tesseract 的目标 DPI（user_defined_dpi）；缺省会让 tesseract 按 96 缩放导致小字崩
OCR_TARGET_DPI=300
# 图像预处理总开关（P1-10，纯 JS）：灰度化 → 对比度拉伸 → 小图放大 → Otsu 二值化 → 去噪
OCR_PREPROCESS=true
# 图片"含义"理解（P1-11）：模型**在知识库页配置**（建/改库时从模型池选一个 supportsVision 的对话模型），
# 不再是环境变量。这里只剩一个低清图判据：
# 低清图判据：短边(min 宽高)小于它的图片不交给 VLM（防止低清缩略图让 VLM 幻觉），只保留图注/OCR。
IMAGE_CAPTION_MIN_PX=256
# 低清图判据（图片文字识别·本地 OCR）：短边小于它的图片**不跑 OCR**（低清只会是噪声）。
# 与 IMAGE_CAPTION_MIN_PX（VLM）独立、可各自调；默认 256。
IMAGE_OCR_MIN_PX=256

# ─────────────────────────────────────────────────────────────────────
# [B] 运行期
# ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
BACKEND_PORT=3000
# 结构化日志级别：trace|debug|info|warn|error|fatal（docs/02 §十三）
LOG_LEVEL=debug
# 是否用 pino-pretty 着色输出。留空则跟随 NODE_ENV（development 时开）。
# CI / 日志采集管道里置 false，取纯 JSON（每行含 requestId，便于链路检索）。
LOG_PRETTY=

# ─────────────────────────────────────────────────────────────────────
# [B] HTTP 出口（P0-1-4 起生效）
# ─────────────────────────────────────────────────────────────────────
# CORS 来源白名单（逗号分隔，形如 scheme://host[:port]，不带路径）。
# 留空 = 反射请求 Origin（仅开发期便利）；**生产必须显式列出**，否则启动打 WARN。
# 不允许写 *（本服务用 Cookie 会话，* 与 credentials 冲突，且等于放开任意站点）。
CORS_ORIGINS=
# /health 单项依赖探活超时（毫秒）。依赖挂起时探活必须能给出结论，而不是一直等。
HEALTH_TIMEOUT_MS=2000

# ─────────────────────────────────────────────────────────────────────
# [B] 会话与安全（P0-1-6 起生效）
# ─────────────────────────────────────────────────────────────────────
# 会话有效期（小时）。命中后按**半衰期滑动续期**：活跃用户不会被踢下线，
# 闲置用户按此上限过期（Redis 里 `session:{sid}` 的 TTL 就是它）。
SESSION_TTL_HOURS=12
# 「每请求校验 user.status」的缓存窗口（秒）。docs/02 §十 点名 60s：
# 窗口内的状态变更由**写侧主动失效**兜住（停用/改角色时删缓存），
# 缓存只用于兜底「直接在库里改状态」这种非本机写入。
USER_STATUS_CACHE_TTL_SEC=60
# 会话 Cookie 是否带 Secure（仅 HTTPS 回传）。留空 = 跟随 NODE_ENV（生产 true）。
# ⚠️ 内网生产若确实是 HTTP 直连，必须显式置 false，否则浏览器会丢弃 Cookie
#    （症状是"登录成功却立刻未登录"）；置 false 时启动会打 WARN。
SESSION_COOKIE_SECURE=

# ─────────────────────────────────────────────────────────────────────
# [G] 种子脚本专用（`pnpm db:seed`；P0-1-9 起）
# ─────────────────────────────────────────────────────────────────────
# ⚠️ 这几项**不进 AppConfig**（`backend/src/config.ts` 不读它们，后端启动/迁移都不受其影响），
#    只在种子脚本进程里生效，故这里整段默认注释掉 —— 需要时自己解开或直接前置到命令行。
# 全都有默认值：用户名 admin/member，密码随机生成 18 位并在脚本 stdout 上**只打印一次**。
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NICKNAME=系统管理员
# SEED_MEMBER_USERNAME=member
# SEED_MEMBER_PASSWORD=
# SEED_MEMBER_NICKNAME=示例成员
# 种子脚本默认**幂等**：已存在的账号只跳过、绝不改密码。确实要重置时显式打开下面这行
# （会把该账号重置成上面的密码，并打回「首登必须改密」状态）。
# SEED_RESET_PASSWORD=1
