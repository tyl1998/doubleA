# ═══════════════════════════════════════════════════════════════════════
# 每台机器上的**实例级**变量（P1-14 · R1）—— 复制成 `infra/router/.env.node`（gitignore）
#
# 与 `docker-compose.host.yml` 一起用：
#   docker compose -f infra/router/docker-compose.host.yml --env-file infra/router/.env.node up -d
#
# ⚠️ 三台机器的这份文件**只有前两行不同**，其余相同。
# ⚠️ 业务变量（DATABASE_URL / REDIS_URL / S3_* / SANDBOX_IMAGE / SANDBOX_EGRESS_PROXY_URL …）不在这里，
#    三台共用一份 ⇒ 由 `SHARED_ENV_FILE` 指向（默认 `infra/router/.env.node.shared`）。
# ═══════════════════════════════════════════════════════════════════════

# 本实例唯一 id：a / b / c（★ 必须唯一：同 id 两实例 ⇒ 对账互相误杀 ⇒ 启动即拒）
SANDBOX_INSTANCE_ID=a
# 网关回连本实例的地址（`host:port`）；也是心跳注册值（自动发现的上游表来源）
SANDBOX_INSTANCE_ADVERTISE_ADDR=a:3000

# 业务后端镜像 tag（`pnpm backend:build-image` 会打印；改镜像内容时 +1 层版本，见 infra/sandbox/versions.mjs）
# ⚠️ 2026-10-19 起后端与网关是**两个镜像**（网关见 infra/router/.env.router.example 的 GATEWAY_IMAGE）
BACKEND_IMAGE=doubulea-backend:2

# 三台共用的那份 env（DATABASE_URL / REDIS_URL / S3_* / SANDBOX_IMAGE / SANDBOX_EGRESS_PROXY_URL …）
SHARED_ENV_FILE=./.env.node.shared

# 宿主工作区根（须与容器内同路径；见 backend/src/config.ts 的 WORKSPACE_ROOT）
WORKSPACE_ROOT=/var/lib/doubulea/workspaces

# egress 代理镜像（沙箱出公网）。默认 node:22-bookworm-slim —— 内网无 registry 时改成
# 已在本机的镜像（例如平台镜像本身：它自带 node，可直接跑 egress-proxy.mjs）
EGRESS_IMAGE=node:22-bookworm-slim

# 业务端口（compose 把它显式透传进容器；healthcheck 与 advertiseAddr 都按它算）
BACKEND_PORT=13000

# ★ 宿主 docker.sock 的 gid：容器内以 uid 10001(doubulea) 跑，不补组就 `EACCES /var/run/docker.sock`
#   Linux：stat -c '%g' /var/run/docker.sock   （Debian/Ubuntu 通常是 docker 组，如 999）
#   macOS：stat -f '%g' /var/run/docker.sock   （OrbStack 实测 0）
DOCKER_SOCKET_GID=0

# egress 容器里挂的宿主 docker CLI（只读）。Linux = /usr/bin/docker；
# ⚠️ macOS 的 docker 是 Mach-O 可执行文件，挂进 Linux 容器不可执行 ⇒ 本机用 egress-up.sh，别用 compose 的 egress
EGRESS_DOCKER_BIN=/usr/bin/docker

# 跨实例节点运维密钥（三台同一份；未配置 ⇒ 只能管理本机实例）
NODE_OPS_SECRET=
# 可选：toolkit 缺镜像时先从这个地址拉取（拉不到再尝试本地构建）
SANDBOX_TOOLKIT_PULL_FROM=

# ★ 沙箱镜像**构建期**换源（不设也有默认值；内网/公司出口通常必须设，否则构建会卡在 apt）：
#   SANDBOX_APT_MIRROR：Debian 源主机名或 URL。默认 mirrors.tuna.tsinghua.edu.cn；不写 scheme 走 HTTP；
#     设成空串 = 用官方 deb.debian.org（仅当这台机器能快速出公网）。
#   SANDBOX_APT_MIN_BPS：apt 网速下限（KB/s，默认 32；0 = 关闭）。低于它就不再干等，直接换源/报错。
# SANDBOX_APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
# SANDBOX_APT_MIN_BPS=32
