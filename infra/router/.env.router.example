# ═══════════════════════════════════════════════════════════════════════
# 路由网关的变量（P1-14 · R1）—— 复制成 `infra/router/.env.router`（gitignore）
#
# 与 `docker-compose.router.yml` 一起用：
#   docker compose -f infra/router/docker-compose.router.yml --env-file infra/router/.env.router up -d
#
# ⚠️ 网关**不要**继承业务后端那份 env：它不需要 DB/S3/CREDENTIAL_MASTER_KEY，
#    而共用 `SANDBOX_INSTANCE_ID` 之类会诱发"网关把自己当实例"。这里只放它真正需要的。
# ═══════════════════════════════════════════════════════════════════════

# 平台镜像 tag（与各台后端**同一份**镜像）
# 网关专用镜像 tag（`pnpm gateway:build` 会打印；与后端镜像共用层版本号）
GATEWAY_IMAGE=doubulea-gateway:2

# 对外入口（生产由 nginx 把 /api、/health 反代到这里）
# ⚠️ **不要用 13000**：那是每台实例后端的端口（`ROUTER_UPSTREAMS` 指向它）。默认 13100。
ROUTER_PORT=13100

# 静态种子：各台实例的**可回连地址**（= 各台 SANDBOX_INSTANCE_ADVERTISE_ADDR）。
# ⚠️ 开了自动发现（默认 10s）后这条仍是**冷启动兜底**：Redis 抖动时它就是全部上游。
ROUTER_UPSTREAMS=10.73.100.153:13000,10.73.100.195:13000
# 自动发现轮询间隔（秒）；`0` = 关闭（此时 ROUTER_UPSTREAMS 必填）
ROUTER_DISCOVERY_SEC=10

# 与后端**同一个** Redis（读会话目录 sandbox:owner:* 与实例注册表 sandbox:instance:*）
REDIS_URL=redis://redis:6379
SANDBOX_OWNER_KEY_PREFIX=sandbox:owner
# 与后端**同名同值**（推导注册项过期 = 3× 心跳）
SANDBOX_INSTANCE_HEARTBEAT_SEC=30
# 注册值缺端口时补的端口（正常心跳都带端口，这里只为兼容手工配置）
BACKEND_PORT=3000
ROUTER_UPSTREAM_TIMEOUT_MS=30000
# 长任务路由（POST /api/admin/node/bootstrap 一键初始化）的「到响应头」上限（毫秒）。
# handler 同步等 Docker 拉镜像/建镜像/起容器才回响应头 ⇒ 单独放宽；默认 15 分钟
ROUTER_UPSTREAM_TIMEOUT_LONG_MS=900000

# 负载感知（P1-14 · R3）：无 owner 时按 P2C 挑较空的实例；`false` = 纯轮询（kill switch）
ROUTER_LOAD_AWARE=true
# 负载新鲜度（毫秒）；不配 = 2× SANDBOX_INSTANCE_HEARTBEAT_SEC（默认 60s）
# ROUTER_LOAD_STALE_MS=60000
