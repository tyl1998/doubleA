# pnpm 行为约定（本机环境见 docs/06-实施计划.md §二 开工前置核对）
#
# 本机 pnpm 12.4.2 经 corepack 提供，必须用**系统 node** 启动：
#   <npm_prefix>\nodejs\node.exe <npm_prefix>\nodejs\node_modules\corepack\dist\pnpm.js <cmd>
# 受管 node 下 pnpm shim 失效（报 Cannot find module ...pnpm.js），故脚本里固定启动方式。

# ⚠️⚠️ 关键实测项：本机 pnpm 12.4.2 的 isolated node-linker 无法把依赖注入各包 node_modules。
#   现象：install 报成功、store（node_modules/.pnpm/*）内容完整，但 shared|backend|frontend/node_modules
#         下只剩**空目录**（无符号链接），构建时报 Cannot find module .../typescript/bin/tsc。
#   排除：本机 symlink/junction 创建能力正常（手工 fs.symlinkSync 成功）；
#         已试过 --force 重装、loglevel=debug 均无任何告警，属静默失败。
#   结论：改用 hoisted 布局（扁平提升到根 node_modules，不做逐包符号链接），全链路可跑通。
#   影响与取舍：
#     - 直接依赖仍严格声明在各自 package.json，workspace 协议不受影响；
#       仅失去 pnpm 默认的「符号链接严格性」防幽灵依赖保护（本项目单人小团队，可接受）。
#     - 若将来 CI/Linux 上隔离布局正常，可去掉本行切回 default，代码无需改动。
node-linker = hoisted

# 依赖提升策略：monorepo 下提升“明确列出的”传递依赖，避免幽灵依赖（phantom dependency）。
# @doubulea/shared 是编译期依赖（见 docs/06 §3.0 要点 3），通过 workspace: 协议显式声明，不靠提升。
resolution-mode = highest

# 允许 workspace 协议（显式声明，避免依赖默认值变化）
link-workspace-packages = true
prefer-workspace-packages = true

# 本项目 Node 只有 v22，无历史包袱，peer 依赖不强制失败（避免上游 package 未更新 peer 范围时装不上）
strict-peer-dependencies = false

# 安装时不做交互确认（CI 与本地一致）
confirmModulesPurge = false

# ⚠️ 依赖生命周期脚本白名单**不写在这里** —— pnpm 10+ 起移到 pnpm-workspace.yaml。
# 原因：pnpm 12.4.2 读 .npmrc 的 onlyBuiltDependencies[] 会被静默丢弃，导致 esbuild 被判为
#       「ignored build scripts」而使 install 直接以 ERR_PNPM_IGNORED_BUILDS 报错退出。
#       本机实际采纳的键是 pnpm-workspace.yaml 的 `allowBuilds`（见该文件注释）。
