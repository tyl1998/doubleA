{
  "name": "doubulea",
  "version": "0.1.0",
  "private": true,
  "description": "内部 Agent 工作台 — 单仓 monorepo（编排层，不装业务依赖）",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "node infra/scripts/link-workspace.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "check:batch": "node infra/scripts/check-batch-marker.mjs",
    "clean": "pnpm -r --no-bail exec node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "backend": "pnpm --filter @doubulea/backend",
    "frontend": "pnpm --filter @doubulea/frontend",
    "shared": "pnpm --filter @doubulea/shared",
    "dev:backend": "pnpm --filter @doubulea/backend dev",
    "start:backend": "pnpm --filter @doubulea/backend start",
    "dev:frontend": "pnpm --filter @doubulea/frontend dev",
    "build:backend": "pnpm --filter @doubulea/backend build",
    "build:frontend": "pnpm --filter @doubulea/frontend build",
    "config:check": "pnpm --filter @doubulea/backend config:check",
    "verify:app": "pnpm --filter @doubulea/backend verify:app",
    "verify:db": "pnpm --filter @doubulea/backend verify:db",
    "verify:session": "pnpm --filter @doubulea/backend verify:session",
    "verify:auth": "pnpm --filter @doubulea/backend verify:auth",
    "verify:users": "pnpm --filter @doubulea/backend verify:users",
    "verify:model-providers": "pnpm --filter @doubulea/backend verify:model-providers",
    "verify:models": "pnpm --filter @doubulea/backend verify:models",
    "verify:llm": "pnpm --filter @doubulea/backend verify:llm",
    "verify:embedding": "pnpm --filter @doubulea/backend verify:embedding",
    "verify:knowledge": "pnpm --filter @doubulea/backend verify:knowledge",
    "verify:documents": "pnpm --filter @doubulea/backend verify:documents",
    "verify:pipeline": "pnpm --filter @doubulea/backend verify:pipeline",
    "verify:ingest": "pnpm --filter @doubulea/backend verify:ingest",
    "verify:knowledge-bases": "pnpm --filter @doubulea/backend verify:knowledge-bases",
    "verify:retrieval": "pnpm --filter @doubulea/backend verify:retrieval",
    "verify:kb-package": "pnpm --filter @doubulea/backend verify:kb-package",
    "verify:agents": "pnpm --filter @doubulea/backend verify:agents",
    "verify:agent-package": "pnpm --filter @doubulea/backend verify:agent-package",
    "verify:conversations": "pnpm --filter @doubulea/backend verify:conversations",
    "verify:chat-stream": "pnpm --filter @doubulea/backend verify:chat-stream",
    "verify:chatbot": "pnpm --filter @doubulea/backend verify:chatbot",
    "verify:chat-package": "pnpm --filter @doubulea/backend verify:chat-package",
    "verify:e2e": "pnpm --filter @doubulea/backend verify:e2e",
    "verify:mcp-client": "pnpm --filter @doubulea/backend verify:mcp-client",
    "verify:chat-sse": "pnpm --filter @doubulea/frontend verify:chat-sse",
    "verify:knowledge-ui": "pnpm --filter @doubulea/frontend verify:knowledge-ui",
    "verify:admin-ui": "pnpm --filter @doubulea/frontend verify:admin-ui",
    "serve:upstreams": "pnpm --filter @doubulea/backend serve:upstreams",
    "db:generate": "pnpm --filter @doubulea/backend db:generate",
    "db:migrate": "pnpm --filter @doubulea/backend db:migrate",
    "db:deploy": "pnpm --filter @doubulea/backend db:deploy",
    "db:status": "pnpm --filter @doubulea/backend db:status",
    "db:partitions": "pnpm --filter @doubulea/backend db:partitions",
    "db:studio": "pnpm --filter @doubulea/backend db:studio",
    "db:seed": "pnpm --filter @doubulea/backend db:seed",
    "infra:up": "node infra/scripts/infra.mjs up",
    "infra:down": "node infra/scripts/infra.mjs down",
    "infra:build": "docker compose -f infra/docker-compose.yml --env-file infra/.env build",
    "infra:logs": "docker compose -f infra/docker-compose.yml --env-file infra/.env logs -f --tail=100",
    "infra:ps": "docker compose -f infra/docker-compose.yml --env-file infra/.env ps",
    "infra:verify": "node infra/scripts/pg-verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "typescript-eslint": "^8.70.0"
  }
}
