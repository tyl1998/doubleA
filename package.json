{
  "name": "doubulea",
  "version": "0.1.0",
  "private": true,
  "description": "内部 Agent 工作台 — 单仓 monorepo（编排层，不装业务依赖）",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "node infra/scripts/link-workspace.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "clean": "pnpm -r --no-bail exec node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "backend": "pnpm --filter @doubulea/backend",
    "frontend": "pnpm --filter @doubulea/frontend",
    "shared": "pnpm --filter @doubulea/shared",
    "dev:backend": "pnpm --filter @doubulea/backend dev",
    "start:backend": "pnpm --filter @doubulea/backend start",
    "dev:frontend": "pnpm --filter @doubulea/frontend dev",
    "build:backend": "pnpm --filter @doubulea/backend build",
    "build:frontend": "pnpm --filter @doubulea/frontend build",
    "config:check": "pnpm --filter @doubulea/backend config:check",
    "verify:app": "pnpm --filter @doubulea/backend verify:app",
    "verify:db": "pnpm --filter @doubulea/backend verify:db",
    "verify:session": "pnpm --filter @doubulea/backend verify:session",
    "verify:auth": "pnpm --filter @doubulea/backend verify:auth",
    "verify:users": "pnpm --filter @doubulea/backend verify:users",
    "db:generate": "pnpm --filter @doubulea/backend db:generate",
    "db:migrate": "pnpm --filter @doubulea/backend db:migrate",
    "db:deploy": "pnpm --filter @doubulea/backend db:deploy",
    "db:status": "pnpm --filter @doubulea/backend db:status",
    "db:partitions": "pnpm --filter @doubulea/backend db:partitions",
    "db:studio": "pnpm --filter @doubulea/backend db:studio",
    "infra:up": "node infra/scripts/infra.mjs up",
    "infra:down": "node infra/scripts/infra.mjs down",
    "infra:build": "docker compose -f infra/docker-compose.yml --env-file infra/.env build",
    "infra:logs": "docker compose -f infra/docker-compose.yml --env-file infra/.env logs -f --tail=100",
    "infra:ps": "docker compose -f infra/docker-compose.yml --env-file infra/.env ps",
    "infra:verify": "node infra/scripts/pg-verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "typescript-eslint": "^8.70.0"
  }
}
