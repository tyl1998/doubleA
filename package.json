{
  "name": "doubulea",
  "version": "0.1.0",
  "private": true,
  "description": "内部 Agent 工作台 — 单仓 monorepo（编排层，不装业务依赖）",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "node infra/scripts/link-workspace.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "check:batch": "node infra/scripts/check-batch-marker.mjs",
    "clean": "pnpm -r --no-bail exec node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "backend": "pnpm --filter @doubulea/backend",
    "frontend": "pnpm --filter @doubulea/frontend",
    "shared": "pnpm --filter @doubulea/shared",
    "dev": "bash infra/scripts/dev-run.sh",
    "dev:stop": "bash infra/scripts/dev-stop.sh",
    "egress:up": "bash infra/scripts/egress-up.sh",
    "egress:down": "bash infra/scripts/egress-down.sh",
    "relay:up": "bash infra/scripts/relay-up.sh",
    "relay:down": "bash infra/scripts/relay-down.sh",
    "dev:backend": "pnpm --filter @doubulea/backend dev",
    "start:backend": "pnpm --filter @doubulea/backend start",
    "dev:frontend": "pnpm --filter @doubulea/frontend dev",
    "build:backend": "pnpm --filter @doubulea/backend build",
    "build:frontend": "pnpm --filter @doubulea/frontend build",
    "config:check": "pnpm --filter @doubulea/backend config:check",
    "verify:chat-sse": "pnpm --filter @doubulea/frontend verify:chat-sse",
    "verify:chat-home": "pnpm --filter @doubulea/frontend verify:chat-home",
    "verify:knowledge-ui": "pnpm --filter @doubulea/frontend verify:knowledge-ui",
    "verify:admin-ui": "pnpm --filter @doubulea/frontend verify:admin-ui",
    "verify:mcp-ui": "pnpm --filter @doubulea/frontend verify:mcp-ui",
    "verify:artifact-preview": "pnpm --filter @doubulea/frontend verify:artifact-preview",
    "verify:artifact-panel": "pnpm --filter @doubulea/frontend verify:artifact-panel",
    "verify:usage-ui": "pnpm --filter @doubulea/frontend verify:usage-ui",
    "verify:memory-ui": "pnpm --filter @doubulea/frontend verify:memory-ui",
    "cron:regression": "pnpm --filter @doubulea/backend cron:regression",
    "notify:regression": "pnpm --filter @doubulea/backend notify:regression",
    "memory:regression": "pnpm --filter @doubulea/backend memory:regression",
    "frame-bus:regression": "pnpm --filter @doubulea/backend frame-bus:regression",
    "workspace:regression": "pnpm --filter @doubulea/backend workspace:regression",
    "git:regression": "pnpm --filter @doubulea/backend git:regression",    "router:regression": "pnpm --filter @doubulea/backend router:regression",
    "router:start": "pnpm --filter @doubulea/backend router:start",
    "router:dev": "pnpm --filter @doubulea/backend router:dev",
    "verify:workspace-ui": "pnpm --filter @doubulea/frontend verify:workspace-ui",
    "verify:git-credentials-ui": "pnpm --filter @doubulea/frontend verify:git-credentials-ui",
    "db:generate": "pnpm --filter @doubulea/backend db:generate",
    "db:migrate": "pnpm --filter @doubulea/backend db:migrate",
    "db:deploy": "pnpm --filter @doubulea/backend db:deploy",
    "db:status": "pnpm --filter @doubulea/backend db:status",
    "db:partitions": "pnpm --filter @doubulea/backend db:partitions",
    "db:studio": "pnpm --filter @doubulea/backend db:studio",
    "db:seed": "pnpm --filter @doubulea/backend db:seed",
    "infra:up": "node infra/scripts/infra.mjs up",
    "infra:down": "node infra/scripts/infra.mjs down",
    "infra:build": "docker compose -f infra/docker-compose.yml --env-file infra/.env build",
    "infra:logs": "docker compose -f infra/docker-compose.yml --env-file infra/.env logs -f --tail=100",
    "infra:ps": "docker compose -f infra/docker-compose.yml --env-file infra/.env ps",
    "infra:verify": "node infra/scripts/pg-verify.mjs",
    "sandbox:build": "node infra/scripts/sandbox-build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "typescript-eslint": "^8.70.0"
  }
}
