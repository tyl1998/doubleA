# ═══════════════════════════════════════════════════════════════════════
# 部署包唯一的 env 文件 —— **只有这一份**，改完 `bash scripts/up.sh` 即可
#
# 设计目标：别人拿到镜像 + 这个目录，**改 6 个值**就能跑起来。
#   必改（标 ★）：MODE / IMAGE_REGISTRY / INSTANCE_IP / CREDENTIAL_MASTER_KEY / POSTGRES_PASSWORD / S3_SECRET
#   其余都有可用默认值。
#
# 语法：KEY=VALUE，不要加 `export`，不要用引号包整行（值里含空格才需要引号）。
# ═══════════════════════════════════════════════════════════════════════

# ─── 1. 形态 ───────────────────────────────────────────────────────────
# ★ all  = 单机全套（后端 + 网关 + 前端都在本机）—— 推荐，第一次部署用这个
#   node = 只加一台沙箱实例（网关/前端在别的主节点；多机扩容时用）
#
# ⚠️ 注意：MODE 只决定"起哪些应用容器"，**不决定会不会碰基础服务**。后者是 MANAGE_INFRA（见第 4 组）。
MODE=all

# ★ 镜像来源。三选一：
#     registry = 从镜像仓库拉取（填 IMAGE_REGISTRY，例如 ghcr.io/tyl1998）
#     local    = 镜像已在本机（docker load 导入过）
#     build    = 从源码构建（需要源码目录，见 SRC_DIR）
IMAGE_SOURCE=registry
IMAGE_REGISTRY=ghcr.io/tyl1998
IMAGE_TAG=2
# IMAGE_SOURCE=build 时用：源码根目录（含 pnpm-workspace.yaml），默认是本仓库根
SRC_DIR=..

# 可选：**逐个覆盖镜像全名**（仓库地址不规整、或前后端不在同一前缀下时用）。
# 留空 = 按 IMAGE_REGISTRY + IMAGE_TAG 拼。设置后 IMAGE_REGISTRY / IMAGE_TAG 对那一项不再生效。
# BACKEND_IMAGE=harbor.corp/doubulea/backend:2
# GATEWAY_IMAGE=harbor.corp/doubulea/gateway:2
# FRONTEND_IMAGE=harbor.corp/doubulea/frontend:2
# POSTGRES_IMAGE=harbor.corp/doubulea/postgres:pg16-vector-bigm

# ─── 2. 本机身份（多机时每台不同）───────────────────────────────────────
# ★ 本机的内网 IP 或域名。**别的机器要能访问到**（不能写 127.0.0.1、不能写 localhost）
INSTANCE_IP=127.0.0.1
# 实例 id（多机时每台不同：a / b / c）。单机随便写；同 id 两台会互相误杀
INSTANCE_ID=local
# 对外端口
BACKEND_PORT=13000
GATEWAY_PORT=13100
FRONTEND_PORT=8080

# ─── 3. 密钥 / 数据库（★ 必须改；同一套环境里所有机器必须一致）─────────
# ★ 凭据加密主密钥（32 字节 base64）。生成：
#     openssl rand -base64 32
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   ⚠️ 一旦有数据写入就**不能改**，否则已加密的凭据全部解不开
CREDENTIAL_MASTER_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32

# ★ 数据库密码（MANAGE_INFRA=1 时用于创建本机 PG；否则就是连现有库的密码）
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_USER=doubulea
POSTGRES_DB=doubulea
# ★ 对象存储密钥（同上：all 时创建本机 MinIO，否则作为远端 MinIO 的密钥）
S3_SECRET=CHANGE_ME_minio_secret
S3_KEY=doubulea

# ─── 4. 依赖服务地址 ───────────────────────────────────────────────────
# ★ 本包**要不要管**基础服务（PostgreSQL / Redis / MinIO）：
#   0（默认）= 不管：只连现有的，**绝不创建、绝不停止**（机器上已有就选这个）
#   1        = 管：自己创建并管理（卷名带 doubulea-deploy- 前缀；仅专用机器用）
MANAGE_INFRA=0

# 留空 = 用本机 127.0.0.1 + 下面的端口；填了 = 连远端那台（通常是主节点的 INSTANCE_IP）
REMOTE_PG_HOST=
REMOTE_PG_PORT=15432
REMOTE_REDIS_HOST=
REMOTE_REDIS_PORT=16379
REMOTE_S3_HOST=
REMOTE_S3_PORT=19000

# MODE=all 时这些是本机容器映射到宿主的端口（冲突才改）
POSTGRES_PORT=15432
REDIS_PORT=16379
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

# ─── 5. 首次初始化（只在库里没有账号时有意义）──────────────────────────
# 创建 admin / member 两个账号（都是首登改密态）。留空 = 随机生成，密码打印在初始化日志里
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_MEMBER_USERNAME=member
SEED_MEMBER_PASSWORD=

# ─── 6. 沙箱（只有 taskAgent / Code 模式需要）──────────────────────────
# 不跑沙箱就设 DOUBULEA_NODE_ROLE=chatbot（不需要 docker 权限，最省事）
DOUBULEA_NODE_ROLE=taskAgent
SANDBOX_IMAGE=doubulea/sandbox-toolkit:8
SANDBOX_IMAGE_BASE=doubulea/sandbox-base:6
# 沙箱并发
SANDBOX_CONCURRENCY=10
SANDBOX_IDLE_TTL_MIN=30
# 工作区根目录（宿主绝对路径）。留空 = 脚本自动用 $HOME/doubulea/workspaces
WORKSPACE_ROOT=
# Linux：stat -c '%g' /var/run/docker.sock ；macOS：stat -f '%g' /var/run/docker.sock
# 留空 = 脚本自动探测
DOCKER_SOCKET_GID=

# 跨实例运维（多机时所有机器**同一份**；不跑多机可留空）
NODE_OPS_SECRET=

# ─── 7. 其它（一般不用改）──────────────────────────────────────────────
TZ=Asia/Shanghai
SESSION_TTL_HOURS=12
CHATBOT_CONCURRENCY=50
SANDBOX_CALLBACK_PORT=13001
# 内网构建沙箱镜像时的换源（沙箱自举「一键初始化」构建 toolkit / 运行时镜像时用到）。
# 留空 = 官方源；内网通常至少设 SANDBOX_NPM_REGISTRY 和 SANDBOX_APT_MIRROR。
SANDBOX_NPM_REGISTRY=
SANDBOX_APT_MIRROR=
# apt 网速下限（KB/s，默认 32；0 = 关闭）。低于它就不再干等，直接换源/报错
SANDBOX_APT_MIN_BPS=
# Node / Rust 发行包镜像（只在按需构建对应语言运行时时用到）
SANDBOX_NODE_DIST_MIRROR=
SANDBOX_RUST_DIST_MIRROR=
