{
  "name": "@doubulea/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "前端应用：React 18 + Vite（独立构建 → frontend/dist，纯静态产物）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:chat-sse": "node --import tsx scripts/verify-chat-sse.mjs",
    "verify:markdown-chunks": "node --import tsx scripts/verify-markdown-chunks.mjs",
    "verify:message-window": "node --import tsx scripts/verify-message-window.mjs",
    "verify:chat-home": "node --import tsx scripts/verify-chat-home.mjs",
    "verify:knowledge-ui": "node --import tsx scripts/verify-knowledge-ui.mjs",
    "verify:admin-ui": "node --import tsx scripts/verify-admin-ui.mjs",
    "verify:mcp-ui": "node --import tsx scripts/verify-mcp-ui.mjs",
    "verify:artifact-preview": "node --import tsx scripts/verify-artifact-preview.mjs",
    "verify:artifact-panel": "node --import tsx scripts/verify-artifact-panel.mjs",
    "verify:usage-ui": "node --import tsx scripts/verify-usage-ui.mjs",
    "verify:sandbox-instances-ui": "node --import tsx scripts/verify-sandbox-instances-ui.mjs",
    "verify:memory-ui": "node --import tsx scripts/verify-memory-ui.mjs",
    "verify:workspace-ui": "node --import tsx scripts/verify-workspace-ui.mjs",
    "verify:git-credentials-ui": "node --import tsx scripts/verify-git-credentials-ui.mjs",
    "verify:asset-acl": "node --import tsx scripts/verify-asset-acl.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@doubulea/shared": "workspace:*",
    "@tanstack/react-query": "^5.103.2",
    "antd": "^5.29.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.6",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
