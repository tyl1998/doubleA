# ===== 依赖 =====
node_modules/
.pnpm-store/

# ===== 构建产物 =====
dist/
build/
*.tsbuildinfo
.vite/
# Vite 在配置文件变更时旁落的临时文件（`vite.config.ts.timestamp-*.mjs`，dev server 退出后可能残留）
vite.config.ts.timestamp-*.mjs

# Prisma 生成物（`prisma generate` 产出，由 build/typecheck 自动重建）
# ⚠️ 位置由 backend/prisma/schema.prisma 的 generator.output 决定，改那里要同步这里。
backend/generated/

# 编译残留防护：tsc 若因 rootDir/outDir 配错而把产物写回源码目录，这些规则兜底。
# （P0-1-1 实际发生过：shared/src 下混入 .js/.d.ts，已清理并加此防护）
**/src/**/*.js
**/src/**/*.js.map
**/src/**/*.d.ts
**/src/**/*.d.ts.map
!**/src/**/*.d.mts
# 例外：**手写的环境声明**（不是 tsc 产物）。约定 `backend/src/types/` 只放手写声明 ——
# 目前只有 `mammoth.d.ts`（该包既不带类型、也没有 `@types/mammoth`，P0-1-16）。
# ⚠️ 若哪天 tsc 真把产物写进这个目录，说明 `rootDir`/`outDir` 配错了，**别用 gitignore 掩盖**。
!backend/src/types/**/*.d.ts

# ===== 环境变量与密钥（绝不提交）=====
.env
.env.local
.env.*.local

# ===== 工作区状态（本机记忆、IDE 配置）=====
.workbuddy/
.vscode/
.idea/
*.swp
*.swo

# ===== 日志与临时文件 =====
*.log
logs/
.pids/
.dev-logs/

# ===== 测试与覆盖率 =====
coverage/
.nyc_output/

# ===== 运行时数据（本地 docker 卷）=====
infra/data/
infra/volumes/

# ===== 操作系统 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== P1-14 · R1 部署编排（每台实例 / 网关的私有 env 与镜像导出包）=====
infra/router/.env.node
infra/router/.env.node.shared
infra/router/.env.router
infra/frontend/.env.frontend
infra/router/*.tar

# 本机单机形态的运行脚本与日志（容器化前的过渡态，不入库）
.run-logs/
